<Project>
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Version>1.1.3</Version>
    <Authors>IAM-GROOT1</Authors>
    <Product>CTRL+Z</Product>
    <Company>IAM-GROOT1</Company>
    <Copyright>Copyright (c) 2026 IAM-GROOT1</Copyright>
    <PackageLicenseExpression>AGPL-3.0-only</PackageLicenseExpression>
    <NeutralLanguage>en-US</NeutralLanguage>
    <Deterministic>true</Deterministic>
    <!-- Keep InformationalVersion exactly equal to the stamped version (for example
         1.3.0-beta.1) so the updater can compare it without stripping a git SHA. -->
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <DebugType>portable</DebugType>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
  </PropertyGroup>
</Project>
