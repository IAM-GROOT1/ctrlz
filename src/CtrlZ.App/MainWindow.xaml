<Window x:Class="CtrlZ.App.MainWindow"
        FlowDirection="{x:Static l:AppLanguage.FlowDirection}"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:CtrlZ.App.Localization"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:vm="clr-namespace:CtrlZ.App.ViewModels"
        Title="CTRL+Z"
        Icon="Assets/ctrlz.ico"
        Width="1180"
        Height="760"
        MinWidth="980"
        MinHeight="640"
        WindowStyle="None"
        ResizeMode="CanResize"
        Background="{DynamicResource Brush.Background}"
        Foreground="{DynamicResource Brush.TextPrimary}"
        FontFamily="{StaticResource Font.Text}"
        TextOptions.TextFormattingMode="Ideal"
        SnapsToDevicePixels="True">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="46"
                            ResizeBorderThickness="6"
                            CornerRadius="0"
                            GlassFrameThickness="0"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Window.InputBindings>
        <KeyBinding Modifiers="Control" Key="D1" Command="{Binding NavigateKeyCommand}" CommandParameter="scan" />
        <KeyBinding Modifiers="Control" Key="D2" Command="{Binding NavigateKeyCommand}" CommandParameter="apps" />
        <KeyBinding Modifiers="Control" Key="D3" Command="{Binding NavigateKeyCommand}" CommandParameter="install" />
        <KeyBinding Modifiers="Control" Key="D4" Command="{Binding NavigateKeyCommand}" CommandParameter="add" />
        <KeyBinding Modifiers="Control" Key="D5" Command="{Binding NavigateKeyCommand}" CommandParameter="catalog" />
        <KeyBinding Modifiers="Control" Key="D6" Command="{Binding NavigateKeyCommand}" CommandParameter="browsers" />
        <KeyBinding Modifiers="Control" Key="D7" Command="{Binding NavigateKeyCommand}" CommandParameter="ready" />
        <KeyBinding Modifiers="Control" Key="D8" Command="{Binding NavigateKeyCommand}" CommandParameter="updates" />
        <KeyBinding Modifiers="Control" Key="D9" Command="{Binding NavigateKeyCommand}" CommandParameter="tweaks" />
        <KeyBinding Modifiers="Control" Key="OemComma" Command="{Binding NavigateKeyCommand}" CommandParameter="settings" />
    </Window.InputBindings>

    <Window.Resources>
        <Style x:Key="NavButton" TargetType="Button">
            <Setter Property="Height" Value="36" />
            <Setter Property="Margin" Value="0,1" />
            <Setter Property="Padding" Value="11,0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="NavBorder" Background="{TemplateBinding Background}" CornerRadius="6"
                                Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                            <Grid>
                                <Border x:Name="AccentBar" Width="2" Height="17" CornerRadius="1"
                                        Background="{DynamicResource Brush.Accent}" HorizontalAlignment="Left"
                                        Margin="-11,0,0,0" Visibility="Collapsed" />
                                <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Stretch"
                                                  TextElement.Foreground="{TemplateBinding Foreground}" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="NavBorder" Property="Background" Value="{DynamicResource Brush.SurfaceHover}" />
                                <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
                            </Trigger>
                            <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                <Setter TargetName="NavBorder" Property="Background" Value="{DynamicResource Brush.Selected}" />
                                <Setter TargetName="AccentBar" Property="Visibility" Value="Visible" />
                                <Setter Property="Foreground" Value="{DynamicResource Brush.SelectedText}" />
                            </DataTrigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="NavBorder" Property="BorderBrush" Value="{DynamicResource Brush.Accent}" />
                                <Setter TargetName="NavBorder" Property="BorderThickness" Value="1" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate x:Key="NavTemplate" DataType="{x:Type vm:NavItem}">
            <Button Style="{StaticResource NavButton}"
                    Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                    CommandParameter="{Binding}"
                    AutomationProperties.Name="{Binding Label}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="22" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding Glyph}" FontFamily="{StaticResource Font.Icons}" FontSize="15"
                               Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                               VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" Text="{Binding Label}" FontSize="12.5" FontWeight="SemiBold"
                               Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                               VerticalAlignment="Center" />
                </Grid>
            </Button>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="232" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="46" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.RowSpan="2" Grid.Column="0" Background="{DynamicResource Brush.Sidebar}"
                BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,1,0" />
        <Border Grid.RowSpan="2" Grid.Column="1" Background="{DynamicResource Brush.Background}" />

        <!-- brand -->
        <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal" Margin="18,0,0,0"
                    VerticalAlignment="Center">
            <Image FlowDirection="LeftToRight" Width="26" Height="26" Source="Assets/ctrlz.png" Stretch="Uniform"
                   RenderOptions.BitmapScalingMode="HighQuality" />
            <TextBlock Text="CTRL+Z" FontFamily="{StaticResource Font.Display}" FontWeight="SemiBold" FontSize="14"
                       Margin="9,0,0,0" VerticalAlignment="Center" />
        </StackPanel>

        <!-- title bar / window controls -->
        <Grid Grid.Row="0" Grid.Column="1" Background="Transparent">
            <TextBlock Text="{Binding ProfileLabel}" FontSize="11.5" Foreground="{DynamicResource Brush.TextTertiary}"
                       HorizontalAlignment="Center" VerticalAlignment="Center" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="MinimizeButton" Style="{StaticResource Button.Window}" Click="Minimize_Click"
                        AutomationProperties.Name="{l:Tr Main_Minimize}">
                    <TextBlock Text="{StaticResource Icon.Minimize}" FontFamily="{StaticResource Font.Icons}" FontSize="10" />
                </Button>
                <Button x:Name="MaximizeButton" Style="{StaticResource Button.Window}" Click="Maximize_Click"
                        AutomationProperties.Name="{l:Tr Main_Maximize}">
                    <TextBlock x:Name="MaximizeGlyph" Text="{StaticResource Icon.Maximize}"
                               FontFamily="{StaticResource Font.Icons}" FontSize="10" />
                </Button>
                <Button x:Name="CloseButton" Style="{StaticResource Button.WindowClose}" Click="Close_Click"
                        AutomationProperties.Name="{l:Tr Main_Close}">
                    <TextBlock Text="{StaticResource Icon.Close}" FontFamily="{StaticResource Font.Icons}" FontSize="10" />
                </Button>
            </StackPanel>
        </Grid>

        <!-- sidebar -->
        <Grid Grid.Row="1" Grid.Column="0" Margin="10,8,10,10">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="0,0,0,12">
                    <TextBlock Text="{l:Tr Main_WORKSPACE}" Style="{StaticResource Text.NavSection}" />
                    <ItemsControl ItemsSource="{Binding WorkspaceNav}" ItemTemplate="{StaticResource NavTemplate}" />

                    <TextBlock Text="{l:Tr Main_DISCOVER}" Style="{StaticResource Text.NavSection}" />
                    <ItemsControl ItemsSource="{Binding DiscoverNav}" ItemTemplate="{StaticResource NavTemplate}" />

                    <TextBlock Text="{l:Tr Main_BROWSERS}" Style="{StaticResource Text.NavSection}" />
                    <ItemsControl ItemsSource="{Binding BrowsersNav}" ItemTemplate="{StaticResource NavTemplate}" />
                </StackPanel>
            </ScrollViewer>

            <StackPanel Grid.Row="1">
                <Separator Margin="4,0,4,8" />
                <ItemsControl ItemsSource="{Binding SettingsNavItems}" ItemTemplate="{StaticResource NavTemplate}" />
                <Grid Margin="12,10,12,4">
                    <TextBlock Text="{l:Tr Main_LocalFirstNoAccount}" FontSize="10.5"
                               Foreground="{DynamicResource Brush.TextTertiary}" />
                    <TextBlock Text="{Binding AppVersion, StringFormat=v{0}}" FontSize="10.5" HorizontalAlignment="Right"
                               Foreground="{DynamicResource Brush.TextTertiary}" />
                </Grid>
            </StackPanel>
        </Grid>

        <!-- page -->
        <Grid Grid.Row="1" Grid.Column="1" Margin="28,18,28,20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <StackPanel Grid.Row="0" Margin="0,0,0,18">
                <TextBlock Text="{Binding CurrentPage.Title}" Style="{StaticResource Text.PageTitle}" />
                <TextBlock Text="{Binding CurrentPage.Subtitle}" Style="{StaticResource Text.PageSubtitle}"
                           MaxWidth="820" HorizontalAlignment="Left" />
            </StackPanel>
            <ContentControl x:Name="PageHost" Grid.Row="1" Content="{Binding CurrentPage}"
                            HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" />
        </Grid>
    </Grid>
</Window>
