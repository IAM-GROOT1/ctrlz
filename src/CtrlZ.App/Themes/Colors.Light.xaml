<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Color x:Key="Color.Background">#F4F4F1</Color>
    <Color x:Key="Color.Sidebar">#EBEBE6</Color>
    <Color x:Key="Color.Surface">#FFFFFF</Color>
    <Color x:Key="Color.SurfaceAlt">#F9F9F6</Color>
    <Color x:Key="Color.SurfaceHover">#F0F0EB</Color>
    <Color x:Key="Color.SurfacePressed">#E6E6E0</Color>
    <Color x:Key="Color.Border">#E0E0D9</Color>
    <Color x:Key="Color.BorderStrong">#C9C9C0</Color>
    <Color x:Key="Color.TextPrimary">#191A17</Color>
    <Color x:Key="Color.TextSecondary">#63675F</Color>
    <Color x:Key="Color.TextTertiary">#8B8F86</Color>
    <Color x:Key="Color.Accent">#CE5228</Color>
    <Color x:Key="Color.AccentHover">#B94721</Color>
    <Color x:Key="Color.AccentPressed">#A13C1B</Color>
    <Color x:Key="Color.AccentSoft">#FBEAE2</Color>
    <Color x:Key="Color.AccentText">#FFFFFF</Color>
    <Color x:Key="Color.Success">#2E7A58</Color>
    <Color x:Key="Color.SuccessSoft">#E4F2EA</Color>
    <Color x:Key="Color.Warning">#9A6418</Color>
    <Color x:Key="Color.WarningSoft">#FBF0DA</Color>
    <Color x:Key="Color.Danger">#AF3B3B</Color>
    <Color x:Key="Color.DangerSoft">#FAE6E6</Color>
    <Color x:Key="Color.Info">#3C6D8C</Color>
    <Color x:Key="Color.InfoSoft">#E7F1F7</Color>
    <Color x:Key="Color.Overlay">#66000000</Color>
    <Color x:Key="Color.LogBackground">#F0F0EB</Color>

    <SolidColorBrush x:Key="Brush.Background" Color="{StaticResource Color.Background}" />
    <SolidColorBrush x:Key="Brush.Sidebar" Color="{StaticResource Color.Sidebar}" />
    <SolidColorBrush x:Key="Brush.Surface" Color="{StaticResource Color.Surface}" />
    <SolidColorBrush x:Key="Brush.SurfaceAlt" Color="{StaticResource Color.SurfaceAlt}" />
    <SolidColorBrush x:Key="Brush.SurfaceHover" Color="{StaticResource Color.SurfaceHover}" />
    <SolidColorBrush x:Key="Brush.SurfacePressed" Color="{StaticResource Color.SurfacePressed}" />
    <SolidColorBrush x:Key="Brush.Border" Color="{StaticResource Color.Border}" />
    <SolidColorBrush x:Key="Brush.BorderStrong" Color="{StaticResource Color.BorderStrong}" />
    <SolidColorBrush x:Key="Brush.TextPrimary" Color="{StaticResource Color.TextPrimary}" />
    <SolidColorBrush x:Key="Brush.TextSecondary" Color="{StaticResource Color.TextSecondary}" />
    <SolidColorBrush x:Key="Brush.TextTertiary" Color="{StaticResource Color.TextTertiary}" />
    <SolidColorBrush x:Key="Brush.Accent" Color="{StaticResource Color.Accent}" />
    <SolidColorBrush x:Key="Brush.AccentHover" Color="{StaticResource Color.AccentHover}" />
    <SolidColorBrush x:Key="Brush.AccentPressed" Color="{StaticResource Color.AccentPressed}" />
    <SolidColorBrush x:Key="Brush.AccentSoft" Color="{StaticResource Color.AccentSoft}" />
    <!-- Selection: the same colours as the accent here; a Windows contrast theme gives them its own. -->
    <SolidColorBrush x:Key="Brush.Selected" Color="{StaticResource Color.AccentSoft}" />
    <SolidColorBrush x:Key="Brush.SelectedText" Color="{StaticResource Color.Accent}" />
    <SolidColorBrush x:Key="Brush.SelectedItemText" Color="{StaticResource Color.TextPrimary}" />
    <SolidColorBrush x:Key="Brush.AccentText" Color="{StaticResource Color.AccentText}" />
    <SolidColorBrush x:Key="Brush.Success" Color="{StaticResource Color.Success}" />
    <SolidColorBrush x:Key="Brush.SuccessSoft" Color="{StaticResource Color.SuccessSoft}" />
    <SolidColorBrush x:Key="Brush.Warning" Color="{StaticResource Color.Warning}" />
    <SolidColorBrush x:Key="Brush.WarningSoft" Color="{StaticResource Color.WarningSoft}" />
    <SolidColorBrush x:Key="Brush.Danger" Color="{StaticResource Color.Danger}" />
    <SolidColorBrush x:Key="Brush.DangerSoft" Color="{StaticResource Color.DangerSoft}" />
    <SolidColorBrush x:Key="Brush.Info" Color="{StaticResource Color.Info}" />
    <SolidColorBrush x:Key="Brush.InfoSoft" Color="{StaticResource Color.InfoSoft}" />
    <SolidColorBrush x:Key="Brush.Overlay" Color="{StaticResource Color.Overlay}" />
    <SolidColorBrush x:Key="Brush.LogBackground" Color="{StaticResource Color.LogBackground}" />
</ResourceDictionary>
