<UserControl x:Class="CtrlZ.App.Controls.AppIcon"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root"
             Focusable="False"
             IsHitTestVisible="False"
             SnapsToDevicePixels="True">
    <Grid>
        <Border x:Name="Fallback" CornerRadius="6" Background="{DynamicResource Brush.SurfacePressed}">
            <TextBlock x:Name="Initials" Text="?" FontFamily="{StaticResource Font.Text}" FontWeight="SemiBold"
                       Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Border>
        <Image FlowDirection="LeftToRight" x:Name="IconImage" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"
               Visibility="Collapsed" />
    </Grid>
</UserControl>
