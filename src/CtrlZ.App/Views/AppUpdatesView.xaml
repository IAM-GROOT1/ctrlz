<UserControl x:Class="CtrlZ.App.Views.AppUpdatesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:CtrlZ.App.Localization"
             Focusable="False">
    <UserControl.Resources>
        <DataTemplate x:Key="AppUpdateRowTemplate">
            <Border Style="{StaticResource Border.Card}" Padding="16,12" Margin="0,0,0,8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}" VerticalAlignment="Top" Margin="0,2,12,0"
                              AutomationProperties.Name="{Binding Name}" />

                    <StackPanel Grid.Column="1">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="13.5"
                                       Foreground="{DynamicResource Brush.TextPrimary}" />
                            <TextBlock Text="{l:Tr AppUpdates_Pinned}" Style="{StaticResource Text.Caption}" Margin="8,1,0,0"
                                       Visibility="{Binding IsPinned, Converter={StaticResource BoolToVisibility}}" />
                        </StackPanel>
                        <TextBlock Style="{StaticResource Text.Caption}" Margin="0,3,0,0">
                            <Run Text="{Binding VersionsText, Mode=OneWay}" />
                            <Run Text="  ·  " />
                            <Run Text="{Binding Id, Mode=OneWay}" FontFamily="{StaticResource Font.Mono}" />
                        </TextBlock>
                        <TextBlock Text="{Binding Status}" Style="{StaticResource Text.Secondary}" TextWrapping="Wrap"
                                   Margin="0,4,0,0" />
                    </StackPanel>

                    <Button Grid.Column="2" Content="{l:Tr AppUpdates_IgnoreThisVersion}" Style="{StaticResource Button.Link}"
                            VerticalAlignment="Top"
                            Command="{Binding DataContext.IgnoreCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                            CommandParameter="{Binding}" />
                </Grid>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <Border Style="{StaticResource Border.Card}" Padding="18,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel>
                        <TextBlock Text="{Binding SummaryTitle}" FontSize="17" FontWeight="SemiBold"
                                   Foreground="{DynamicResource Brush.TextPrimary}" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding StatusLine}" Style="{StaticResource Text.Secondary}"
                                   TextWrapping="Wrap" Margin="0,6,0,0" />
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                        <Button Content="{l:Tr AppUpdates_CheckAgain}" Style="{StaticResource Button.Secondary}"
                                Command="{Binding CheckCommand}" />
                        <Button Content="{l:Tr AppUpdates_UpdateSelected}" Style="{StaticResource Button.Secondary}" Margin="8,0,0,0"
                                Command="{Binding UpdateSelectedCommand}" />
                        <Button Content="{l:Tr AppUpdates_UpdateAll}" Style="{StaticResource Button.Primary}" Margin="8,0,0,0"
                                Command="{Binding UpdateAllCommand}" />
                        <Button Content="{l:Tr AppUpdates_Cancel}" Style="{StaticResource Button.Secondary}" Margin="8,0,0,0"
                                Command="{Binding CancelCommand}"
                                Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />
                    </StackPanel>
                </Grid>
            </Border>

            <StackPanel Orientation="Horizontal" Margin="2,12,0,4">
                <CheckBox Content="{l:Tr AppUpdates_ShowIgnoredVersions}" IsChecked="{Binding ShowIgnored, Mode=TwoWay}" />
                <TextBlock Text="{l:Tr AppUpdates_UpdatesComeFromWingetPinned}"
                           Style="{StaticResource Text.Caption}" Margin="16,0,0,0" VerticalAlignment="Center" />
            </StackPanel>

            <ItemsControl ItemsSource="{Binding Rows}" ItemTemplate="{StaticResource AppUpdateRowTemplate}" />

            <Border Style="{StaticResource Border.Inset}" Padding="14,12" Margin="0,4,0,12"
                    Visibility="{Binding HasRows, Converter={StaticResource InverseBoolToVisibility}}">
                <TextBlock Style="{StaticResource Text.Secondary}" TextWrapping="Wrap"
                           Text="{l:Tr AppUpdates_NoUpdatesToShowApps}" />
            </Border>

            <StackPanel Visibility="{Binding HasGitHubRows, Converter={StaticResource BoolToVisibility}}" Margin="0,8,0,12">
                <TextBlock Text="{l:Tr AppUpdates_FROMGITHUBRELEASES}" Style="{StaticResource Text.NavSection}" Margin="2,0,0,8" />
                <ItemsControl ItemsSource="{Binding GitHubRows}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource Border.Card}" Padding="16,12" Margin="0,0,0,8">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="13.5"
                                                   Foreground="{DynamicResource Brush.TextPrimary}" />
                                        <TextBlock Style="{StaticResource Text.Caption}" Margin="0,3,0,0">
                                            <Run Text="{Binding VersionsText, Mode=OneWay}" />
                                            <Run Text="  ·  " />
                                            <Run Text="{Binding Repository, Mode=OneWay}" FontFamily="{StaticResource Font.Mono}" />
                                        </TextBlock>
                                        <TextBlock Text="{Binding Status}" Style="{StaticResource Text.Secondary}"
                                                   TextWrapping="Wrap" Margin="0,4,0,0" />
                                    </StackPanel>
                                    <Button Grid.Column="1" Content="{l:Tr AppUpdates_Update}" Style="{StaticResource Button.Secondary}"
                                            VerticalAlignment="Top"
                                            Command="{Binding DataContext.UpdateGitHubCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Margin="2,2,0,0"
                           Text="{l:Tr AppUpdates_AppsInstalledFromAGitHub}" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
