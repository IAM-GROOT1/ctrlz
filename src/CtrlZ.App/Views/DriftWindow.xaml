<Window x:Class="CtrlZ.App.Views.DriftWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Profile drift"
        Width="780"
        SizeToContent="Height"
        MinHeight="240"
        MaxHeight="760"
        WindowStyle="None"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{DynamicResource Brush.Surface}"
        Foreground="{DynamicResource Brush.TextPrimary}"
        FontFamily="{StaticResource Font.Text}">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="42" ResizeBorderThickness="0" GlassFrameThickness="0"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <DataTemplate x:Key="DriftRowTemplate">
            <Border BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,0,1" Padding="2,9">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel>
                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="12.5"
                                   Foreground="{DynamicResource Brush.TextPrimary}" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding Detail}" Style="{StaticResource Text.Caption}" TextWrapping="Wrap" />
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="{Binding ConfidenceLabel}" Style="{StaticResource Text.Caption}"
                                   Margin="0,0,10,0" VerticalAlignment="Center" />
                        <Button Content="Add to profile" Style="{StaticResource Button.Link}"
                                Command="{Binding DataContext.AddToProfileCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                CommandParameter="{Binding}"
                                Visibility="{Binding CanAddToProfile, Converter={StaticResource BoolToVisibility}}" />
                        <Button Content="Install" Style="{StaticResource Button.Link}" Margin="8,0,0,0"
                                Command="{Binding DataContext.InstallMissingCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                CommandParameter="{Binding}"
                                Visibility="{Binding CanInstall, Converter={StaticResource BoolToVisibility}}" />
                        <Button Content="Remove" Style="{StaticResource Button.Link}" Margin="8,0,0,0"
                                Command="{Binding DataContext.RemoveFromProfileCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                CommandParameter="{Binding}"
                                Visibility="{Binding CanRemoveFromProfile, Converter={StaticResource BoolToVisibility}}" />
                        <Button Content="Ignore" Style="{StaticResource Button.Link}" Margin="8,0,0,0"
                                Command="{Binding DataContext.IgnoreCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                CommandParameter="{Binding}" />
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <Border BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="42" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="{DynamicResource Brush.SurfaceAlt}"
                    BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,0,1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="46" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" Margin="16,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="&#xE71D;" FontFamily="{StaticResource Font.Icons}" FontSize="15"
                                   Foreground="{DynamicResource Brush.Accent}" Margin="0,0,9,0" />
                        <TextBlock Text="Profile drift" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
                    </StackPanel>
                    <Button Grid.Column="1" Style="{StaticResource Button.Window}" Click="Close_Click"
                            AutomationProperties.Name="Close">
                        <TextBlock Text="&#xE711;" FontFamily="{StaticResource Font.Icons}" FontSize="10" />
                    </Button>
                </Grid>
            </Border>

            <ScrollViewer Grid.Row="1" MaxHeight="560" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="20,16,20,8">
                    <TextBlock Text="{Binding SummaryText}" FontSize="13.5" FontWeight="SemiBold"
                               Foreground="{DynamicResource Brush.TextPrimary}" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding StatusLine}" Style="{StaticResource Text.Caption}" Margin="0,4,0,0" />

                    <StackPanel Margin="0,14,0,0" Visibility="{Binding HasMissing, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="IN YOUR PROFILE, NOT INSTALLED" Style="{StaticResource Text.NavSection}" />
                        <ItemsControl ItemsSource="{Binding Missing}" ItemTemplate="{StaticResource DriftRowTemplate}" />
                    </StackPanel>

                    <StackPanel Margin="0,14,0,0" Visibility="{Binding HasExtra, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="INSTALLED, NOT IN YOUR PROFILE" Style="{StaticResource Text.NavSection}" />
                        <ItemsControl ItemsSource="{Binding Extra}" ItemTemplate="{StaticResource DriftRowTemplate}" />
                    </StackPanel>

                    <StackPanel Margin="0,14,0,0" Visibility="{Binding HasOutdated, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="OUTDATED" Style="{StaticResource Text.NavSection}" />
                        <ItemsControl ItemsSource="{Binding Outdated}" ItemTemplate="{StaticResource DriftRowTemplate}" />
                    </StackPanel>

                    <Border Style="{StaticResource Border.Inset}" Padding="14,12" Margin="0,10,0,0"
                            Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Style="{StaticResource Text.Secondary}" TextWrapping="Wrap"
                                   Text="No differences found. Your saved profile matches what is installed on this PC." />
                    </Border>

                    <TextBlock Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Margin="0,12,0,0"
                               Text="Matching uses the winget package id first, then the app name and publisher. 'Uncertain' rows are left for you to decide rather than guessed." />
                </StackPanel>
            </ScrollViewer>

            <Border Grid.Row="2" Padding="20,12,20,18" Background="{DynamicResource Brush.Surface}">
                <Grid>
                    <Button Content="Re-check" Style="{StaticResource Button.Secondary}" HorizontalAlignment="Left"
                            Command="{Binding RescanCommand}"
                            IsEnabled="{Binding IsBusy, Converter={StaticResource BoolNegation}}" />
                    <Button Content="Close" Style="{StaticResource Button.Primary}" HorizontalAlignment="Right"
                            MinWidth="96" IsDefault="True" IsCancel="True" Command="{Binding CloseCommand}" />
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
