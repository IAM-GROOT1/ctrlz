<Window x:Class="CtrlZ.App.Views.PreviewWindow"
        FlowDirection="{x:Static l:AppLanguage.FlowDirection}"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:CtrlZ.App.Localization"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="{l:Tr Preview_PreviewInstall}"
        Width="800"
        SizeToContent="Height"
        MinHeight="260"
        MaxHeight="780"
        WindowStyle="None"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{DynamicResource Brush.Surface}"
        Foreground="{DynamicResource Brush.TextPrimary}"
        FontFamily="{StaticResource Font.Text}">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="42" ResizeBorderThickness="0" GlassFrameThickness="0"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <DataTemplate x:Key="PreviewRowTemplate">
            <Border BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,0,1" Padding="2,8">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="26" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="{Binding OrderText}" Style="{StaticResource Text.Caption}"
                                   VerticalAlignment="Top" Margin="0,2,0,0" />

                        <StackPanel Grid.Column="1">
                            <TextBlock Text="{Binding Name, Converter={StaticResource UserText}}" FontWeight="SemiBold" FontSize="12.5"
                                       Foreground="{DynamicResource Brush.TextPrimary}" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding SourceText}" Style="{StaticResource Text.Caption}"
                                       TextWrapping="Wrap" />
                            <TextBlock Style="{StaticResource Text.Caption}" TextWrapping="Wrap">
                                <Run Text="{l:Tr Preview_Switches}" /><Run Text="{Binding SilentText, Mode=OneWay}" />
                            </TextBlock>
                            <TextBlock Text="{Binding NotesText}" Style="{StaticResource Text.Caption}"
                                       TextWrapping="Wrap" />
                        </StackPanel>

                        <StackPanel Grid.Column="2" VerticalAlignment="Top" HorizontalAlignment="Right">
                            <TextBlock Text="{Binding AdminText}" Style="{StaticResource Text.Caption}"
                                       HorizontalAlignment="Right" />
                            <TextBlock Text="{Binding DryRunText}" Style="{StaticResource Text.Caption}"
                                       TextWrapping="Wrap" MaxWidth="230" TextAlignment="Right"
                                       Margin="0,2,0,0"
                                       Visibility="{Binding HasDryRun, Converter={StaticResource BoolToVisibility}}" />
                        </StackPanel>
                    </Grid>

                    <TextBlock Text="{Binding WarningText}" Style="{StaticResource Text.Caption}" TextWrapping="Wrap"
                               Margin="26,4,0,0" Foreground="{DynamicResource Brush.Warning}"
                               Visibility="{Binding HasWarnings, Converter={StaticResource BoolToVisibility}}" />

                    <StackPanel Margin="26,6,0,0"
                                Visibility="{Binding HasCommand, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="{l:Tr Preview_AfterInstallRuns}" Style="{StaticResource Text.Caption}" />
                        <TextBlock Text="{Binding CommandText}" Style="{StaticResource Text.Caption}" TextWrapping="Wrap" FlowDirection="LeftToRight"
                                   Foreground="{DynamicResource Brush.TextPrimary}" />
                        <TextBlock Text="{Binding CommandStateText}" TextWrapping="Wrap">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource Text.Caption}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding CommandNeedsAttention}" Value="True">
                                            <Setter Property="Foreground" Value="{DynamicResource Brush.Warning}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </StackPanel>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <Border BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="42" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="{DynamicResource Brush.SurfaceAlt}"
                    BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,0,1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="46" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" Margin="16,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="&#xE896;" FontFamily="{StaticResource Font.Icons}" FontSize="15"
                                   Foreground="{DynamicResource Brush.Accent}" Margin="0,0,9,0" />
                        <TextBlock Text="{l:Tr Preview_PreviewInstall}" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
                    </StackPanel>
                    <Button Grid.Column="1" Style="{StaticResource Button.Window}" Click="Close_Click"
                            AutomationProperties.Name="{l:Tr Preview_Close}">
                        <TextBlock Text="&#xE711;" FontFamily="{StaticResource Font.Icons}" FontSize="10" />
                    </Button>
                </Grid>
            </Border>

            <ScrollViewer Grid.Row="1" MaxHeight="560" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="20,16,20,8">
                    <TextBlock Text="{Binding SummaryText}" FontSize="13.5" FontWeight="SemiBold"
                               Foreground="{DynamicResource Brush.TextPrimary}" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding StatusLine}" Style="{StaticResource Text.Caption}" TextWrapping="Wrap"
                               Margin="0,4,0,0" />
                    <TextBlock Text="{Binding DryRunSummary}" Style="{StaticResource Text.Caption}" TextWrapping="Wrap"
                               Margin="0,2,0,0" />

                    <ItemsControl ItemsSource="{Binding PlanWarnings}" Margin="0,8,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" Style="{StaticResource Text.Caption}" TextWrapping="Wrap"
                                           Margin="0,1,0,0" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <ItemsControl ItemsSource="{Binding Items}" ItemTemplate="{StaticResource PreviewRowTemplate}"
                                  Margin="0,10,0,0" />

                    <TextBlock Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Margin="0,12,0,0"
                               Text="{l:Tr Preview_NothingHasBeenInstalledYet}" />
                </StackPanel>
            </ScrollViewer>

            <Border Grid.Row="2" Padding="20,12,20,18" Background="{DynamicResource Brush.Surface}">
                <Grid>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                        <Button Content="{l:Tr Preview_DryRun}" Style="{StaticResource Button.Secondary}"
                                Command="{Binding DryRunCommand}"
                                IsEnabled="{Binding IsDryRunning, Converter={StaticResource BoolNegation}}" />
                        <Button Content="{l:Tr Preview_ExportReport}" Style="{StaticResource Button.Link}" Margin="12,0,0,0"
                                Command="{Binding ExportReportCommand}" VerticalAlignment="Center" />
                        <Button Content="{l:Tr Preview_ReviewCommands}" Style="{StaticResource Button.Link}" Margin="12,0,0,0"
                                Command="{Binding ReviewCommandsCommand}" VerticalAlignment="Center"
                                Visibility="{Binding HasCommandsToReview, Converter={StaticResource BoolToVisibility}}" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="{l:Tr Preview_Cancel}" Style="{StaticResource Button.Secondary}" MinWidth="96"
                                IsCancel="True" Command="{Binding CancelCommand}" />
                        <Button Content="{l:Tr Preview_InstallNow}" Style="{StaticResource Button.Primary}" MinWidth="120"
                                Margin="8,0,0,0" IsDefault="True" Command="{Binding ProceedCommand}" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
