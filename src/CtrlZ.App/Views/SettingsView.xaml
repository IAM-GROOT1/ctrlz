<UserControl x:Class="CtrlZ.App.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignHeight="620" d:DesignWidth="900">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.1*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="0.9*" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <Border Style="{StaticResource Border.Card}" Padding="18,16">
                    <StackPanel>
                        <TextBlock Text="APPEARANCE" Style="{StaticResource Text.NavSection}" Margin="0,0,0,10" />
                        <TextBlock Text="Theme" Style="{StaticResource Text.Label}" />
                        <Border Style="{StaticResource Border.Inset}" Padding="2" HorizontalAlignment="Left">
                            <StackPanel Orientation="Horizontal">
                                <ToggleButton Content="System" Style="{StaticResource Toggle.Pill}"
                                              IsChecked="{Binding IsSystemTheme, Mode=OneWay}"
                                              Command="{Binding SetThemeCommand}" CommandParameter="system" />
                                <ToggleButton Content="Light" Style="{StaticResource Toggle.Pill}"
                                              IsChecked="{Binding IsLightTheme, Mode=OneWay}"
                                              Command="{Binding SetThemeCommand}" CommandParameter="light" />
                                <ToggleButton Content="Dark" Style="{StaticResource Toggle.Pill}"
                                              IsChecked="{Binding IsDarkTheme, Mode=OneWay}"
                                              Command="{Binding SetThemeCommand}" CommandParameter="dark" />
                            </StackPanel>
                        </Border>
                        <TextBlock Text="{Binding ThemeDescription}" Style="{StaticResource Text.Caption}" Margin="0,8,0,0" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Border.Card}" Padding="18,16" Margin="0,14,0,0">
                    <StackPanel>
                        <TextBlock Text="LOCAL DATA" Style="{StaticResource Text.NavSection}" Margin="0,0,0,10" />
                        <TextBlock Text="Profiles, downloads, archives, and logs live under one folder. Nothing is uploaded." 
                                   Style="{StaticResource Text.Secondary}" TextWrapping="Wrap" />
                        <Border Style="{StaticResource Border.Inset}" Padding="10,8" Margin="0,12,0,0">
                            <TextBlock Text="{Binding DataFolder}" FontFamily="{StaticResource Font.Mono}" FontSize="10.5"
                                       TextWrapping="Wrap" Foreground="{DynamicResource Brush.TextSecondary}" />
                        </Border>
                        <WrapPanel Margin="0,10,0,0">
                            <Button Content="Open data folder" Style="{StaticResource Button.Secondary}" Margin="0,0,8,8"
                                    Command="{Binding OpenDataFolderCommand}" />
                            <Button Content="Profiles" Style="{StaticResource Button.Ghost}" Margin="0,0,8,8"
                                    Command="{Binding OpenProfilesFolderCommand}" />
                            <Button Content="Logs" Style="{StaticResource Button.Ghost}" Margin="0,0,8,8"
                                    Command="{Binding OpenLogsFolderCommand}" />
                        </WrapPanel>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Border.Card}" Padding="18,16" Margin="0,14,0,0">
                    <StackPanel>
                        <TextBlock Text="UPDATES" Style="{StaticResource Text.NavSection}" Margin="0,0,0,10" />
                        <TextBlock Text="{Binding CurrentVersionText}" FontWeight="SemiBold" FontSize="13" />
                        <TextBlock Text="{Binding LastUpdateCheckText}" Style="{StaticResource Text.Caption}" Margin="0,3,0,0" />
                        <CheckBox Content="Check for updates automatically" Margin="0,12,0,0"
                                  IsChecked="{Binding AutoCheckForUpdates, Mode=TwoWay}" />
                        <TextBlock Text="Channel" Style="{StaticResource Text.Label}" Margin="0,12,0,6" />
                        <Border Style="{StaticResource Border.Inset}" Padding="2" HorizontalAlignment="Left">
                            <StackPanel Orientation="Horizontal">
                                <ToggleButton Content="Stable" Style="{StaticResource Toggle.Pill}"
                                              IsChecked="{Binding IsStableChannel, Mode=OneWay}"
                                              Command="{Binding SetUpdateChannelCommand}" CommandParameter="stable" />
                                <ToggleButton Content="Pre-release" Style="{StaticResource Toggle.Pill}"
                                              IsChecked="{Binding IsPreReleaseChannel, Mode=OneWay}"
                                              Command="{Binding SetUpdateChannelCommand}" CommandParameter="prerelease" />
                            </StackPanel>
                        </Border>
                        <TextBlock Text="{Binding ChannelDescription}" Style="{StaticResource Text.Caption}"
                                   TextWrapping="Wrap" Margin="0,8,0,0" />
                        <Button Content="Check for updates" Style="{StaticResource Button.Secondary}"
                                HorizontalAlignment="Left" Margin="0,12,0,0"
                                Command="{Binding CheckForUpdatesCommand}"
                                IsEnabled="{Binding CanCheckForUpdates}" />
                        <TextBlock Text="Only the version check and an update download talk to GitHub. Nothing else is sent, and CTRL+Z has no telemetry."
                                   Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Margin="0,10,0,0" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Border.Card}" Padding="18,16" Margin="0,14,0,0">
                    <StackPanel>
                        <TextBlock Text="ABOUT" Style="{StaticResource Text.NavSection}" Margin="0,0,0,10" />
                        <StackPanel Orientation="Horizontal">
                            <Image Width="36" Height="36" Source="Assets/ctrlz.png" Stretch="Uniform"
                                   RenderOptions.BitmapScalingMode="HighQuality" />
                            <StackPanel Margin="11,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="CTRL+Z" FontWeight="SemiBold" FontSize="15" />
                                <TextBlock Text="{Binding AppVersion, StringFormat=Version {0}}" Style="{StaticResource Text.Caption}" />
                            </StackPanel>
                        </StackPanel>
                        <TextBlock Text="A local-first Windows reinstall assistant. No account, no telemetry. Browser backups exclude passwords and cookies by design."
                                   Style="{StaticResource Text.Secondary}" TextWrapping="Wrap" Margin="0,12,0,0" />
                        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                            <Button Content="AGPL-3.0-only" Style="{StaticResource Button.Ghost}" Command="{Binding OpenLicenseCommand}" />
                            <Button Content="Source code" Style="{StaticResource Button.Ghost}" Margin="6,0,0,0"
                                    Command="{Binding OpenSourceCodeCommand}" />
                            <Button Content="Copy diagnostics" Style="{StaticResource Button.Ghost}" Margin="6,0,0,0"
                                    Command="{Binding CopyDiagnosticsCommand}" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>

            <StackPanel Grid.Column="2">
                <Border Style="{StaticResource Border.Card}" Padding="18,16">
                    <StackPanel>
                        <TextBlock Text="PACKAGE MANAGER" Style="{StaticResource Text.NavSection}" Margin="0,0,0,10" />
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="7" Height="7" Fill="{DynamicResource Brush.Success}" Margin="0,0,8,0"
                                     VerticalAlignment="Center" />
                            <TextBlock Text="{Binding WingetStatus}" Style="{StaticResource Text.Body}" TextWrapping="Wrap" />
                        </StackPanel>
                        <TextBlock Text="winget is used for catalog apps. CTRL+Z can bootstrap it on a clean Windows install using Microsoft App Installer."
                                   Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Margin="0,8,0,0" />
                        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                            <Button Content="Check again" Style="{StaticResource Button.Ghost}" Command="{Binding CheckWingetCommand}" />
                            <Button Content="Update winget" Style="{StaticResource Button.Secondary}" Margin="6,0,0,0"
                                    Command="{Binding UpdateWingetCommand}" IsEnabled="{Binding IsBusy, Converter={StaticResource BoolNegation}}" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Border.Card}" Padding="0" Margin="0,14,0,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="300" />
                        </Grid.RowDefinitions>
                        <Border Background="{DynamicResource Brush.SurfaceAlt}" Padding="14,8"
                                BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,0,1">
                            <Grid>
                                <TextBlock Text="APPLICATION LOG" Style="{StaticResource Text.NavSection}" Margin="0" />
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Button Content="Refresh" Style="{StaticResource Button.Link}" Command="{Binding RefreshLogCommand}" />
                                    <Button Content="Open log" Style="{StaticResource Button.Link}" Margin="10,0,0,0"
                                            Command="{Binding OpenLogFileCommand}" />
                                </StackPanel>
                            </Grid>
                        </Border>
                        <TextBox Grid.Row="1" Text="{Binding LogText}" Style="{StaticResource Text.LogBox}"
                                 BorderThickness="0" VerticalScrollBarVisibility="Auto"
                                 HorizontalScrollBarVisibility="Disabled" TextWrapping="NoWrap" />
                    </Grid>
                </Border>

                <Border Style="{StaticResource Border.Inset}" Padding="11,8" Margin="0,14,0,0"
                        Visibility="{Binding HasStatus, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource Text.Caption}" TextWrapping="Wrap" />
                </Border>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</UserControl>
