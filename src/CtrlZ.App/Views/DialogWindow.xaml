<Window x:Class="CtrlZ.App.Views.DialogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:CtrlZ.App.Localization"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="CTRL+Z"
        Width="470"
        SizeToContent="Height"
        MinHeight="180"
        MaxHeight="720"
        WindowStyle="None"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{DynamicResource Brush.Surface}"
        Foreground="{DynamicResource Brush.TextPrimary}"
        FontFamily="{StaticResource Font.Text}">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="42" ResizeBorderThickness="0" GlassFrameThickness="0"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Border BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="42" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="{DynamicResource Brush.SurfaceAlt}"
                    BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,0,1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="46" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" Margin="16,0,0,0" VerticalAlignment="Center">
                        <TextBlock x:Name="TitleIcon" Text="&#xE946;" FontFamily="{StaticResource Font.Icons}"
                                   FontSize="15" Foreground="{DynamicResource Brush.Accent}" Margin="0,0,9,0" />
                        <TextBlock x:Name="TitleText" Text="CTRL+Z" FontSize="13" FontWeight="SemiBold"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                    <Button Grid.Column="1" Style="{StaticResource Button.Window}"
                            Click="Close_Click" AutomationProperties.Name="{l:Tr Dialog_Close}">
                        <TextBlock Text="&#xE711;" FontFamily="{StaticResource Font.Icons}" FontSize="10" />
                    </Button>
                </Grid>
            </Border>

            <ScrollViewer Grid.Row="1" MaxHeight="440" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="22,20,22,10">
                    <TextBlock x:Name="MessageText" TextWrapping="Wrap" FontSize="13.5" LineHeight="20"
                               Foreground="{DynamicResource Brush.TextPrimary}" />
                    <StackPanel x:Name="InputPanel" Margin="0,16,0,0" Visibility="Collapsed">
                        <TextBlock x:Name="InputLabel" Style="{StaticResource Text.Label}" />
                        <TextBox AutomationProperties.Name="{Binding Text, ElementName=InputLabel}" x:Name="InputBox" />
                    </StackPanel>
                    <CheckBox AutomationProperties.Name="{Binding Content, RelativeSource={RelativeSource Self}}" x:Name="ExtraCheckBox" Margin="0,16,0,0" Visibility="Collapsed" />
                </StackPanel>
            </ScrollViewer>

            <Border Grid.Row="2" Padding="22,12,22,18" Background="{DynamicResource Brush.Surface}">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button AutomationProperties.Name="{Binding Content, RelativeSource={RelativeSource Self}}" x:Name="SecondaryButton" Style="{StaticResource Button.Secondary}" Margin="0,0,8,0"
                            Click="Secondary_Click" MinWidth="86" />
                    <Button AutomationProperties.Name="{Binding Content, RelativeSource={RelativeSource Self}}" x:Name="PrimaryButton" Style="{StaticResource Button.Primary}" Click="Primary_Click"
                            MinWidth="96" IsDefault="True" />
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
