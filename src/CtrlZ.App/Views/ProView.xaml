<UserControl x:Class="CtrlZ.App.Views.ProView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:CtrlZ.App.ViewModels"
             mc:Ignorable="d" d:DesignHeight="620" d:DesignWidth="900">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="860" HorizontalAlignment="Left">
            <Border Style="{StaticResource Border.Card}" Padding="18,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border Width="42" Height="42" CornerRadius="10" Background="{DynamicResource Brush.AccentSoft}">
                        <TextBlock Text="{StaticResource Icon.Lock}" FontFamily="{StaticResource Font.Icons}"
                                   FontSize="19" Foreground="{DynamicResource Brush.Accent}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Grid.Column="1" Margin="13,0,16,0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding StateTitle}" Style="{StaticResource Text.SectionTitle}" />
                            <Border Background="{DynamicResource Brush.AccentSoft}" CornerRadius="7" Padding="6,1"
                                    Margin="9,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="PRO" FontSize="9" FontWeight="SemiBold"
                                           Foreground="{DynamicResource Brush.Accent}" />
                            </Border>
                        </StackPanel>
                        <TextBlock Text="{Binding LicenseStateText}" Style="{StaticResource Text.Secondary}"
                                   TextWrapping="Wrap" Margin="0,4,0,0" />
                        <TextBlock Text="{Binding LastCheckText}" Style="{StaticResource Text.Caption}"
                                   Margin="0,3,0,0" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Content="Manage license" Style="{StaticResource Button.Ghost}"
                                Command="{Binding ManageLicenseCommand}" Margin="0,0,8,0" />
                        <Button Content="Unlock Pro" Style="{StaticResource Button.Primary}"
                                Command="{Binding UnlockProCommand}" MinWidth="105" />
                    </StackPanel>
                </Grid>
            </Border>

            <Border Style="{StaticResource Border.Card}" Padding="18,16" Margin="0,14,0,0">
                <StackPanel>
                    <Grid>
                        <TextBlock Text="PRO MODULE" Style="{StaticResource Text.NavSection}" Margin="0" />
                        <TextBlock Text="{Binding ModuleVersion}" Style="{StaticResource Text.Caption}"
                                   HorizontalAlignment="Right" />
                    </Grid>
                    <TextBlock Text="{Binding ModuleName}" FontWeight="SemiBold" FontSize="13" Margin="0,9,0,0" />
                    <TextBlock Text="{Binding ModuleDescription}" Style="{StaticResource Text.Secondary}"
                               TextWrapping="Wrap" Margin="0,4,0,0" />
                    <Border Style="{StaticResource Border.Inset}" Padding="10,8" Margin="0,10,0,0"
                            Background="{DynamicResource Brush.WarningSoft}"
                            Visibility="{Binding HasModuleError, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="{Binding ModuleError}" Style="{StaticResource Text.Caption}"
                                   TextWrapping="Wrap" Foreground="{DynamicResource Brush.Warning}" />
                    </Border>
                    <TextBlock Text="Install the optional CtrlZ.Pro.dll next to CTRL+Z or in the data folder's pro folder. The free app works without it."
                               Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Margin="0,10,0,0" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Border.Card}" Padding="0" Margin="0,14,0,0">
                <StackPanel>
                    <Border Background="{DynamicResource Brush.SurfaceAlt}" Padding="14,8"
                            BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,0,1">
                        <TextBlock Text="FEATURES" Style="{StaticResource Text.NavSection}" Margin="0" />
                    </Border>
                    <ItemsControl ItemsSource="{Binding Features}" Margin="12,6">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:ProFeatureItemViewModel}">
                                <Border Style="{StaticResource Border.Inset}" Padding="12,10" Margin="0,0,0,7">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="30" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Glyph}" FontFamily="{StaticResource Font.Icons}"
                                                   FontSize="15" Foreground="{DynamicResource Brush.Accent}"
                                                   VerticalAlignment="Center" />
                                        <StackPanel Grid.Column="1" Margin="4,0,12,0">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" FontSize="12.5" />
                                                <Border Background="{DynamicResource Brush.AccentSoft}" CornerRadius="7"
                                                        Padding="6,1" Margin="8,0,0,0" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding StateLabel}" FontSize="9"
                                                               Foreground="{DynamicResource Brush.Accent}" />
                                                </Border>
                                            </StackPanel>
                                            <TextBlock Text="{Binding Description}" Style="{StaticResource Text.Caption}"
                                                       TextWrapping="Wrap" Margin="0,3,0,0" />
                                        </StackPanel>
                                        <Button Grid.Column="2" Content="Open" Style="{StaticResource Button.Secondary}"
                                                VerticalAlignment="Center" IsEnabled="{Binding CanOpen}"
                                                Command="{Binding DataContext.OpenFeatureCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="No Pro features are installed yet. The free core is complete."
                               Style="{StaticResource Text.Secondary}" Margin="14,10,14,16"
                               Visibility="{Binding HasFeatures, Converter={StaticResource InverseBoolToVisibility}}" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Border.Inset}" Padding="12,10" Margin="0,14,0,0">
                <TextBlock Text="CTRL+Z does not collect telemetry. The only network requests are license activation, revalidation, and deactivation to the license server you configure."
                           Style="{StaticResource Text.Caption}" TextWrapping="Wrap" />
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
