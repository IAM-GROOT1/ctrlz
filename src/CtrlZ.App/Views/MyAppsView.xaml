<UserControl x:Class="CtrlZ.App.Views.MyAppsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:CtrlZ.App.Localization"
             xmlns:controls="clr-namespace:CtrlZ.App.Controls"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignHeight="620" d:DesignWidth="900">
    <UserControl.Resources>
        <DataTemplate x:Key="ProfileAppTemplate">
            <Border BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,0,1" Padding="6,8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="30" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="96" />
                        <ColumnDefinition Width="220" />
                        <ColumnDefinition Width="124" />
                    </Grid.ColumnDefinitions>

                    <CheckBox IsChecked="{Binding IsIncluded, Mode=TwoWay}" VerticalAlignment="Center"
                              ToolTip="{l:Tr MyApps_IncludeInInstalls}" AutomationProperties.Name="{l:Tr MyApps_IncludeInInstalls}" />

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <controls:AppIcon IconPath="{Binding IconPath}" FallbackText="{Binding Name}" Size="30" />
                        <TextBlock Text="&#xE70B;" FontFamily="{StaticResource Font.Icons}" FontSize="11"
                                   VerticalAlignment="Center" Margin="6,0,0,0"
                                   Foreground="{DynamicResource Brush.TextTertiary}"
                                   ToolTip="{l:Tr MyApps_ThisAppHasANote}"
                                   Visibility="{Binding HasNotes, Converter={StaticResource BoolToVisibility}}" />
                        <StackPanel Margin="10,0,10,0" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="12.5"
                                           TextTrimming="CharacterEllipsis" />
                                <Border Background="{DynamicResource Brush.WarningSoft}" CornerRadius="8" Padding="6,1"
                                        Margin="8,0,0,0" VerticalAlignment="Center"
                                        Visibility="{Binding NeedsAttention, Converter={StaticResource BoolToVisibility}}">
                                    <TextBlock Text="{l:Tr MyApps_NeedsId}" FontSize="9.5" Foreground="{DynamicResource Brush.Warning}" />
                                </Border>
                            </StackPanel>
                            <TextBlock Text="{Binding Meta}" Style="{StaticResource Text.Caption}" Margin="0,2,0,0"
                                       TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </StackPanel>

                    <Border Grid.Column="2" Style="{StaticResource Border.Pill}" HorizontalAlignment="Left">
                        <TextBlock Text="{Binding SourceLabel}" FontSize="10.5" Foreground="{DynamicResource Brush.TextSecondary}" />
                    </Border>

                    <TextBlock Grid.Column="3" Text="{Binding InstallSummary}" Style="{StaticResource Text.Caption}"
                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,10,0"
                               ToolTip="{Binding InstallSummary}" />

                    <StackPanel Grid.Column="4" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Button AutomationProperties.Name="{Binding Name, StringFormat={l:Tr MyApps_MoveNameUp}}" Style="{StaticResource Button.Icon}" Width="26" Height="26"
                                Command="{Binding DataContext.MoveUpCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                CommandParameter="{Binding}" ToolTip="{l:Tr MyApps_MoveEarlier}">
                            <TextBlock Text="{StaticResource Icon.Up}" FontFamily="{StaticResource Font.Icons}" FontSize="12" />
                        </Button>
                        <Button AutomationProperties.Name="{Binding Name, StringFormat={l:Tr MyApps_MoveNameDown}}" Style="{StaticResource Button.Icon}" Width="26" Height="26"
                                Command="{Binding DataContext.MoveDownCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                CommandParameter="{Binding}" ToolTip="{l:Tr MyApps_MoveLater}">
                            <TextBlock Text="{StaticResource Icon.Down}" FontFamily="{StaticResource Font.Icons}" FontSize="12" />
                        </Button>
                        <Button AutomationProperties.Name="{Binding Name, StringFormat={l:Tr MyApps_EditName}}" Style="{StaticResource Button.Icon}" Width="26" Height="26"
                                Command="{Binding DataContext.EditAppCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                CommandParameter="{Binding}" ToolTip="{l:Tr MyApps_EditApp}">
                            <TextBlock Text="{StaticResource Icon.Edit}" FontFamily="{StaticResource Font.Icons}" FontSize="12" />
                        </Button>
                        <Button AutomationProperties.Name="{Binding Name, StringFormat={l:Tr MyApps_RemoveName}}" Style="{StaticResource Button.Icon}" Width="26" Height="26"
                                Command="{Binding DataContext.RemoveAppCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                CommandParameter="{Binding}" ToolTip="{l:Tr MyApps_RemoveFromProfile}">
                            <TextBlock Text="{StaticResource Icon.Delete}" FontFamily="{StaticResource Font.Icons}" FontSize="12" />
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>

        <GroupStyle x:Key="AppsGroupStyle">
            <GroupStyle.HeaderTemplate>
                <DataTemplate>
                    <Grid Margin="4,12,4,5">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding Name}" FontSize="11" FontWeight="SemiBold"
                                       Foreground="{DynamicResource Brush.TextSecondary}" />
                            <Border Background="{DynamicResource Brush.SurfacePressed}" CornerRadius="8" Padding="6,1"
                                    Margin="8,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding ItemCount}" FontSize="9.5"
                                           Foreground="{DynamicResource Brush.TextSecondary}" />
                            </Border>
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </GroupStyle.HeaderTemplate>
        </GroupStyle>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- profile bar -->
        <Border Grid.Row="0" Style="{StaticResource Border.Card}" Padding="12,10" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{l:Tr MyApps_Profile}" Style="{StaticResource Text.Label}" VerticalAlignment="Center" Margin="2,0,10,0" />
                <ComboBox AutomationProperties.Name="{l:Tr MyApps_Profile}" Grid.Column="1" Width="230" ItemsSource="{Binding Profiles}"
                          SelectedItem="{Binding SelectedProfile, Mode=TwoWay}" MinHeight="34">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                <TextBlock Grid.Column="1" Text="{Binding AppCount}" Style="{StaticResource Text.Caption}"
                                           Margin="10,0,0,0" />
                            </Grid>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="10,0,0,0">
                    <Button Style="{StaticResource Button.Icon}" Command="{Binding NewProfileCommand}"
                            ToolTip="{l:Tr MyApps_NewProfile}" AutomationProperties.Name="{l:Tr MyApps_NewProfile}">
                        <TextBlock Text="{StaticResource Icon.Add}" FontFamily="{StaticResource Font.Icons}" FontSize="12" />
                    </Button>
                    <Button Style="{StaticResource Button.Icon}" Command="{Binding RenameProfileCommand}"
                            ToolTip="{l:Tr MyApps_RenameProfile}" AutomationProperties.Name="{l:Tr MyApps_RenameProfile}">
                        <TextBlock Text="{StaticResource Icon.Edit}" FontFamily="{StaticResource Font.Icons}" FontSize="12" />
                    </Button>
                    <Button Style="{StaticResource Button.Icon}" Command="{Binding ImportProfileCommand}"
                            ToolTip="{l:Tr MyApps_ImportProfile}" AutomationProperties.Name="{l:Tr MyApps_ImportProfile}">
                        <TextBlock Text="{StaticResource Icon.Folder}" FontFamily="{StaticResource Font.Icons}" FontSize="12" />
                    </Button>
                    <Button Style="{StaticResource Button.Icon}" Command="{Binding ExportProfileCommand}"
                            ToolTip="{l:Tr MyApps_ExportProfile}" AutomationProperties.Name="{l:Tr MyApps_ExportProfile}">
                        <TextBlock Text="{StaticResource Icon.Save}" FontFamily="{StaticResource Font.Icons}" FontSize="12" />
                    </Button>
                    <Button Style="{StaticResource Button.Icon}" Command="{Binding DeleteProfileCommand}"
                            Foreground="{DynamicResource Brush.Danger}" ToolTip="{l:Tr MyApps_DeleteProfile}"
                            AutomationProperties.Name="{l:Tr MyApps_DeleteProfile}">
                        <TextBlock Text="{StaticResource Icon.Delete}" FontFamily="{StaticResource Font.Icons}" FontSize="12" />
                    </Button>
                </StackPanel>
                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource Button.Primary}" Command="{Binding InstallAppsCommand}"
                            IsEnabled="{Binding CanInstall}" MinWidth="108">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{StaticResource Icon.Install}" FontFamily="{StaticResource Font.Icons}"
                                       FontSize="13" Foreground="White" Margin="0,0,7,0" />
                            <TextBlock Text="{l:Tr MyApps_Install}" Style="{StaticResource Text.Button}" Foreground="White" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- filters -->
        <Grid Grid.Row="1" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <!-- The search box gives up width first, so longer labels on the right never cover the count. -->
            <Grid Margin="0,0,10,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MaxWidth="270" MinWidth="140" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid>
                    <TextBox AutomationProperties.Name="{l:Tr MyApps_SearchApps}" x:Name="SearchBox" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                             Padding="30,7,10,7" />
                    <TextBlock Text="{StaticResource Icon.Search}" FontFamily="{StaticResource Font.Icons}" FontSize="12"
                               Foreground="{DynamicResource Brush.TextTertiary}" Margin="10,0,0,0"
                               VerticalAlignment="Center" IsHitTestVisible="False" />
                    <TextBlock Text="{l:Tr MyApps_SearchThisProfile}" Foreground="{DynamicResource Brush.TextTertiary}" FontSize="12"
                               Margin="31,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value="">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
                <TextBlock Grid.Column="1" Text="{Binding SelectionText}" Style="{StaticResource Text.Secondary}" Margin="14,0,0,0"
                           VerticalAlignment="Center" />
            </Grid>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Border Style="{StaticResource Border.Inset}" Padding="2" Margin="0,0,10,0">
                    <StackPanel Orientation="Horizontal">
                        <ToggleButton Content="{l:Tr MyApps_Source}" Style="{StaticResource Toggle.Pill}"
                                      IsChecked="{Binding GroupBySource, Mode=OneWay}"
                                      Command="{Binding ToggleGroupingCommand}" CommandParameter="source" />
                        <ToggleButton Content="{l:Tr MyApps_Category}"
                                      Command="{Binding ToggleGroupingCommand}" CommandParameter="category">
                            <ToggleButton.Style>
                                <Style TargetType="ToggleButton" BasedOn="{StaticResource Toggle.Pill}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding GroupBySource}" Value="False">
                                            <Setter Property="Background" Value="{DynamicResource Brush.AccentSoft}" />
                                            <Setter Property="Foreground" Value="{DynamicResource Brush.Accent}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ToggleButton.Style>
                        </ToggleButton>
                    </StackPanel>
                </Border>
                <Button Content="{l:Tr MyApps_AddApp}" Style="{StaticResource Button.Secondary}" Command="{Binding AddAppCommand}" />
                <Button Content="{l:Tr MyApps_ImportList}" Style="{StaticResource Button.Ghost}" Margin="8,0,0,0"
                        Command="{Binding ImportPackageListCommand}"
                        ToolTip="{l:Tr MyApps_AddAppsFromAWinget}" />
                <Button Content="{l:Tr MyApps_CheckDrift}" Style="{StaticResource Button.Ghost}" Margin="8,0,0,0"
                        Command="{Binding CheckDriftCommand}" />
            </StackPanel>
        </Grid>

        <!-- list -->
        <Border Grid.Row="2" Style="{StaticResource Border.Card}" Padding="0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Border Grid.Row="0" Background="{DynamicResource Brush.SurfaceAlt}" Padding="10,7"
                        BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,0,1"
                        Visibility="{Binding HasApps, Converter={StaticResource BoolToVisibility}}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="30" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="96" />
                            <ColumnDefinition Width="220" />
                            <ColumnDefinition Width="124" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="1" Text="{l:Tr MyApps_APP}" Style="{StaticResource Text.NavSection}" Margin="16,0,0,0" />
                        <TextBlock Grid.Column="2" Text="{l:Tr MyApps_SourceHeading}" Style="{StaticResource Text.NavSection}" Margin="0" />
                        <TextBlock Grid.Column="3" Text="{l:Tr MyApps_INSTALLMETHOD}" Style="{StaticResource Text.NavSection}" Margin="0" />
                    </Grid>
                </Border>

                <ListView Grid.Row="1" ItemsSource="{Binding AppsView}" ItemTemplate="{StaticResource ProfileAppTemplate}"
                          ItemContainerStyle="{StaticResource {x:Type ListBoxItem}}"
                          BorderThickness="0" Background="Transparent" Padding="0"
                          ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                          VirtualizingPanel.IsVirtualizing="True"
                          VirtualizingPanel.VirtualizationMode="Recycling"
                          VirtualizingPanel.IsVirtualizingWhenGrouping="True"
                          Visibility="{Binding HasApps, Converter={StaticResource BoolToVisibility}}">
                    <ListView.GroupStyle>
                        <StaticResource ResourceKey="AppsGroupStyle" />
                    </ListView.GroupStyle>
                </ListView>

                <StackPanel Grid.RowSpan="2" VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="460"
                            Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}">
                    <Border Width="52" Height="52" CornerRadius="26" Background="{DynamicResource Brush.AccentSoft}"
                            HorizontalAlignment="Center">
                        <TextBlock Text="{StaticResource Icon.Apps}" FontFamily="{StaticResource Font.Icons}" FontSize="22"
                                   Foreground="{DynamicResource Brush.Accent}" HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="{l:Tr MyApps_ThisProfileIsEmpty}" Style="{StaticResource Text.SectionTitle}"
                               HorizontalAlignment="Center" Margin="0,16,0,4" />
                    <TextBlock Text="{l:Tr MyApps_ScanThisPCToBuild}"
                               Style="{StaticResource Text.Secondary}" TextAlignment="Center" TextWrapping="Wrap" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,18,0,0">
                        <Button Content="{l:Tr MyApps_ScanThisPC}" Style="{StaticResource Button.Primary}" Command="{Binding ScanCommand}"
                                Margin="0,0,8,0" />
                        <Button Content="{l:Tr MyApps_BrowseCatalog}" Style="{StaticResource Button.Secondary}"
                                Command="{Binding BrowseCatalogCommand}" />
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>

        <!-- footer -->
        <Grid Grid.Row="3" Margin="0,12,0,0">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource Text.Caption}" />
                <TextBlock Text=" · " Style="{StaticResource Text.Caption}" />
                <Button Content="{l:Tr MyApps_SelectAll}" Style="{StaticResource Button.Link}" Command="{Binding SelectAllSourcesCommand}" />
                <TextBlock Text=" · " Style="{StaticResource Text.Caption}" />
                <Button Content="{l:Tr MyApps_AddApps}" Style="{StaticResource Button.Link}" Command="{Binding AddAppCommand}" />
            </StackPanel>
            <TextBlock Text="{Binding AppCountText}" Style="{StaticResource Text.Caption}" HorizontalAlignment="Right"
                       VerticalAlignment="Center" />
        </Grid>
    </Grid>
</UserControl>
