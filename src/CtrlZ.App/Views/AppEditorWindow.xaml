<Window x:Class="CtrlZ.App.Views.AppEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:CtrlZ.App.Localization"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="{l:Tr AppEditor_EditApp}"
        Width="620" Height="720"
        MinHeight="580"
        WindowStyle="None"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{DynamicResource Brush.Surface}"
        Foreground="{DynamicResource Brush.TextPrimary}"
        FontFamily="{StaticResource Font.Text}">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="42" ResizeBorderThickness="6" GlassFrameThickness="0"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>
    <Border BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="42" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border Background="{DynamicResource Brush.SurfaceAlt}" BorderBrush="{DynamicResource Brush.Border}"
                    BorderThickness="0,0,0,1">
                <Grid>
                    <StackPanel Orientation="Horizontal" Margin="16,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="&#xE70F;" FontFamily="{StaticResource Font.Icons}" FontSize="14"
                                   Foreground="{DynamicResource Brush.Accent}" Margin="0,0,9,0" />
                        <TextBlock Text="{l:Tr AppEditor_EditApp}" FontSize="13" FontWeight="SemiBold" />
                    </StackPanel>
                    <Button AutomationProperties.Name="{l:Tr AppEditor_Close}" Style="{StaticResource Button.Window}" HorizontalAlignment="Right" Click="Close_Click">
                        <TextBlock Text="{StaticResource Icon.Close}" FontFamily="{StaticResource Font.Icons}" FontSize="10" />
                    </Button>
                </Grid>
            </Border>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="24,20,24,12">
                    <TextBlock Text="{l:Tr AppEditor_IDENTITY}" Style="{StaticResource Text.NavSection}" Margin="0,0,0,10" />
                    <TextBlock Text="{l:Tr AppEditor_Name}" Style="{StaticResource Text.Label}" />
                    <TextBox AutomationProperties.Name="{l:Tr AppEditor_Name}" x:Name="NameBox" />

                    <Grid Margin="0,14,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="14" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="{l:Tr AppEditor_Publisher}" Style="{StaticResource Text.Label}" />
                            <TextBox AutomationProperties.Name="{l:Tr AppEditor_Publisher}" x:Name="PublisherBox" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="{l:Tr AppEditor_Category}" Style="{StaticResource Text.Label}" />
                            <ComboBox AutomationProperties.Name="{l:Tr AppEditor_Category}" x:Name="CategoryBox" DisplayMemberPath="Label" />
                        </StackPanel>
                    </Grid>

                    <TextBlock Text="{l:Tr AppEditor_SOURCE}" Style="{StaticResource Text.NavSection}" Margin="0,20,0,10" />
                    <TextBlock Text="{l:Tr AppEditor_InstallFrom}" Style="{StaticResource Text.Label}" />
                    <ComboBox AutomationProperties.Name="{l:Tr AppEditor_InstallFrom}" x:Name="SourceBox" DisplayMemberPath="Label"
                              SelectionChanged="SourceBox_SelectionChanged" />

                    <StackPanel x:Name="WingetPanel" Margin="0,14,0,0">
                        <TextBlock Text="{l:Tr AppEditor_WingetPackageId}" Style="{StaticResource Text.Label}" />
                        <TextBox AutomationProperties.Name="{l:Tr AppEditor_WingetPackageId}" x:Name="PackageIdBox" FontFamily="{StaticResource Font.Mono}" />
                        <TextBlock Text="{l:Tr AppEditor_UseTheExactIdFor}"
                                   Style="{StaticResource Text.Caption}" Margin="0,5,0,0" />
                    </StackPanel>

                    <StackPanel x:Name="DirectPanel" Margin="0,14,0,0" Visibility="Collapsed">
                        <TextBlock Text="{l:Tr AppEditor_DownloadURL}" Style="{StaticResource Text.Label}" />
                        <TextBox AutomationProperties.Name="{l:Tr AppEditor_DownloadURL}" x:Name="UrlBox" />
                        <TextBlock Text="{l:Tr AppEditor_FileNameOverrideOptional}" Style="{StaticResource Text.Label}" Margin="0,12,0,6" />
                        <TextBox AutomationProperties.Name="{l:Tr AppEditor_FileNameOverrideOptional}" x:Name="FileNameBox" />
                    </StackPanel>

                    <StackPanel x:Name="GitHubPanel" Margin="0,14,0,0" Visibility="Collapsed">
                        <TextBlock Text="{l:Tr AppEditor_RepositoryOwnerProject}" Style="{StaticResource Text.Label}" />
                        <TextBox AutomationProperties.Name="{l:Tr AppEditor_RepositoryOwnerProject}" x:Name="RepoBox" />
                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="160" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="{l:Tr AppEditor_AssetNameBlankBestWindows}" Style="{StaticResource Text.Label}" />
                                <TextBox AutomationProperties.Name="{l:Tr AppEditor_AssetNameBlankMeansThe}" x:Name="AssetBox" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="{l:Tr AppEditor_AssetType}" Style="{StaticResource Text.Label}" />
                                <ComboBox AutomationProperties.Name="{l:Tr AppEditor_AssetType}" x:Name="AssetKindBox" DisplayMemberPath="Label" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>

                    <StackPanel x:Name="LocalPanel" Margin="0,14,0,0" Visibility="Collapsed">
                        <TextBlock Text="{l:Tr AppEditor_InstallerPath}" Style="{StaticResource Text.Label}" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox AutomationProperties.Name="{l:Tr AppEditor_LocalInstallerPath}" x:Name="LocalPathBox" />
                            <Button Grid.Column="1" Content="{l:Tr AppEditor_Browse}" Style="{StaticResource Button.Secondary}"
                                    Margin="8,0,0,0" Click="Browse_Click" />
                        </Grid>
                    </StackPanel>

                    <TextBlock Text="{l:Tr AppEditor_INSTALLBEHAVIOUR}" Style="{StaticResource Text.NavSection}" Margin="0,20,0,10" />
                    <TextBlock Text="{l:Tr AppEditor_SilentSwitchesBlankAutoDetect}" Style="{StaticResource Text.Label}" />
                    <TextBox AutomationProperties.Name="{l:Tr AppEditor_SilentSwitchesBlankMeansAuto}" x:Name="SilentArgsBox" FontFamily="{StaticResource Font.Mono}" />
                    <TextBlock Text="{l:Tr AppEditor_SHA256OptionalDirectGitHub}" Style="{StaticResource Text.Label}" Margin="0,12,0,6" />
                    <TextBox AutomationProperties.Name="{l:Tr AppEditor_SHA256Optional}" x:Name="HashBox" FontFamily="{StaticResource Font.Mono}" />
                    <TextBlock Text="{l:Tr AppEditor_Notes}" Style="{StaticResource Text.Label}" Margin="0,12,0,6" />
                    <TextBox AutomationProperties.Name="{l:Tr AppEditor_Notes}" x:Name="NotesBox" Height="64" AcceptsReturn="True" TextWrapping="Wrap"
                             VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto" />
                    <TextBlock Text="{l:Tr AppEditor_StoredAsPlainTextIn}"
                               Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Margin="0,4,0,0" />
                    <CheckBox x:Name="EnabledBox" Content="{l:Tr AppEditor_IncludeThisAppInInstalls}" Margin="0,16,0,0" />

                    <TextBlock Text="{l:Tr AppEditor_AFTERINSTALL}" Style="{StaticResource Text.NavSection}" Margin="0,20,0,10" />
                    <StackPanel x:Name="CommandEditPanel">
                        <TextBlock Text="{l:Tr AppEditor_ProgramToRunBlankNo}" Style="{StaticResource Text.Label}" />
                        <TextBox AutomationProperties.Name="{l:Tr AppEditor_ProgramToRunBlankMeans}" x:Name="CommandExeBox" FontFamily="{StaticResource Font.Mono}" />
                        <TextBlock Text="{l:Tr AppEditor_ArgumentsOnePerLineNo}" Style="{StaticResource Text.Label}" Margin="0,12,0,6" />
                        <TextBox AutomationProperties.Name="{l:Tr AppEditor_ArgumentsOnePerLine}" x:Name="CommandArgsBox" Height="64" AcceptsReturn="True" TextWrapping="NoWrap"
                                 FontFamily="{StaticResource Font.Mono}"
                                 VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto" />
                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="14" />
                                <ColumnDefinition Width="120" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="{l:Tr AppEditor_WorkingDirectoryOptional}" Style="{StaticResource Text.Label}" />
                                <TextBox AutomationProperties.Name="{l:Tr AppEditor_WorkingDirectoryOptional}" x:Name="CommandDirBox" FontFamily="{StaticResource Font.Mono}" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="{l:Tr AppEditor_TimeoutSeconds}" Style="{StaticResource Text.Label}" />
                                <TextBox AutomationProperties.Name="{l:Tr AppEditor_TimeoutInSeconds}" x:Name="CommandTimeoutBox" />
                            </StackPanel>
                        </Grid>
                        <CheckBox x:Name="CommandElevatedBox" Content="{l:Tr AppEditor_RunThisCommandAsAdministrator}" Margin="0,12,0,0" />
                        <CheckBox x:Name="CommandEnabledBox" Content="{l:Tr AppEditor_RunThisCommandAfterThe}" Margin="0,8,0,0" />
                        <TextBlock Text="{l:Tr AppEditor_CommandsRunWithoutAShell}"
                                   Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Margin="0,4,0,0" />
                    </StackPanel>
                    <StackPanel x:Name="CommandReadOnlyPanel" Visibility="Collapsed">
                        <TextBlock x:Name="CommandReadOnlyText" Style="{StaticResource Text.Caption}" TextWrapping="Wrap"
                                   FontFamily="{StaticResource Font.Mono}" Foreground="{DynamicResource Brush.TextPrimary}" />
                        <TextBlock Text="{l:Tr AppEditor_ThisProfileDidNotOriginate}"
                                   Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Margin="0,4,0,0" />
                    </StackPanel>

                    <TextBlock x:Name="ErrorText" Foreground="{DynamicResource Brush.Danger}" FontSize="11.5"
                               TextWrapping="Wrap" Margin="0,12,0,0" Visibility="Collapsed" />
                </StackPanel>
            </ScrollViewer>

            <Border Grid.Row="2" Background="{DynamicResource Brush.SurfaceAlt}" BorderBrush="{DynamicResource Brush.Border}"
                    BorderThickness="0,1,0,0" Padding="24,14">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="{l:Tr AppEditor_Cancel}" Style="{StaticResource Button.Secondary}" MinWidth="84" Margin="0,0,8,0" IsCancel="True"
                            Click="Close_Click" />
                    <Button Content="{l:Tr AppEditor_SaveChanges}" Style="{StaticResource Button.Primary}" MinWidth="110"
                            Click="Save_Click" IsDefault="True" />
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
