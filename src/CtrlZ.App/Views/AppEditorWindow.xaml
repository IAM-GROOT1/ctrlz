<Window x:Class="CtrlZ.App.Views.AppEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Edit app"
        Width="620" Height="720"
        MinHeight="580"
        WindowStyle="None"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{DynamicResource Brush.Surface}"
        Foreground="{DynamicResource Brush.TextPrimary}"
        FontFamily="{StaticResource Font.Text}">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="42" ResizeBorderThickness="6" GlassFrameThickness="0"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>
    <Border BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="42" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border Background="{DynamicResource Brush.SurfaceAlt}" BorderBrush="{DynamicResource Brush.Border}"
                    BorderThickness="0,0,0,1">
                <Grid>
                    <StackPanel Orientation="Horizontal" Margin="16,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="&#xE70F;" FontFamily="{StaticResource Font.Icons}" FontSize="14"
                                   Foreground="{DynamicResource Brush.Accent}" Margin="0,0,9,0" />
                        <TextBlock Text="Edit app" FontSize="13" FontWeight="SemiBold" />
                    </StackPanel>
                    <Button Style="{StaticResource Button.Window}" HorizontalAlignment="Right" Click="Close_Click">
                        <TextBlock Text="{StaticResource Icon.Close}" FontFamily="{StaticResource Font.Icons}" FontSize="10" />
                    </Button>
                </Grid>
            </Border>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="24,20,24,12">
                    <TextBlock Text="IDENTITY" Style="{StaticResource Text.NavSection}" Margin="0,0,0,10" />
                    <TextBlock Text="Name" Style="{StaticResource Text.Label}" />
                    <TextBox x:Name="NameBox" />

                    <Grid Margin="0,14,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="14" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Publisher" Style="{StaticResource Text.Label}" />
                            <TextBox x:Name="PublisherBox" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Category" Style="{StaticResource Text.Label}" />
                            <ComboBox x:Name="CategoryBox" DisplayMemberPath="Label" />
                        </StackPanel>
                    </Grid>

                    <TextBlock Text="SOURCE" Style="{StaticResource Text.NavSection}" Margin="0,20,0,10" />
                    <TextBlock Text="Install from" Style="{StaticResource Text.Label}" />
                    <ComboBox x:Name="SourceBox" DisplayMemberPath="Label"
                              SelectionChanged="SourceBox_SelectionChanged" />

                    <StackPanel x:Name="WingetPanel" Margin="0,14,0,0">
                        <TextBlock Text="winget package id" Style="{StaticResource Text.Label}" />
                        <TextBox x:Name="PackageIdBox" FontFamily="{StaticResource Font.Mono}" />
                        <TextBlock Text="Use the exact id, for example Mozilla.Firefox or 7zip.7zip."
                                   Style="{StaticResource Text.Caption}" Margin="0,5,0,0" />
                    </StackPanel>

                    <StackPanel x:Name="DirectPanel" Margin="0,14,0,0" Visibility="Collapsed">
                        <TextBlock Text="Download URL" Style="{StaticResource Text.Label}" />
                        <TextBox x:Name="UrlBox" />
                        <TextBlock Text="File name override (optional)" Style="{StaticResource Text.Label}" Margin="0,12,0,6" />
                        <TextBox x:Name="FileNameBox" />
                    </StackPanel>

                    <StackPanel x:Name="GitHubPanel" Margin="0,14,0,0" Visibility="Collapsed">
                        <TextBlock Text="Repository (owner/project)" Style="{StaticResource Text.Label}" />
                        <TextBox x:Name="RepoBox" />
                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="160" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Asset name (blank = best Windows asset)" Style="{StaticResource Text.Label}" />
                                <TextBox x:Name="AssetBox" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Asset type" Style="{StaticResource Text.Label}" />
                                <ComboBox x:Name="AssetKindBox" DisplayMemberPath="Label" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>

                    <StackPanel x:Name="LocalPanel" Margin="0,14,0,0" Visibility="Collapsed">
                        <TextBlock Text="Installer path" Style="{StaticResource Text.Label}" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="LocalPathBox" />
                            <Button Grid.Column="1" Content="Browse…" Style="{StaticResource Button.Secondary}"
                                    Margin="8,0,0,0" Click="Browse_Click" />
                        </Grid>
                    </StackPanel>

                    <TextBlock Text="INSTALL BEHAVIOUR" Style="{StaticResource Text.NavSection}" Margin="0,20,0,10" />
                    <TextBlock Text="Silent switches (blank = auto-detect at install time)" Style="{StaticResource Text.Label}" />
                    <TextBox x:Name="SilentArgsBox" FontFamily="{StaticResource Font.Mono}" />
                    <TextBlock Text="SHA-256 (optional, direct/GitHub/local downloads)" Style="{StaticResource Text.Label}" Margin="0,12,0,6" />
                    <TextBox x:Name="HashBox" FontFamily="{StaticResource Font.Mono}" />
                    <TextBlock Text="Notes" Style="{StaticResource Text.Label}" Margin="0,12,0,6" />
                    <TextBox x:Name="NotesBox" Height="64" AcceptsReturn="True" TextWrapping="Wrap"
                             VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto" />
                    <TextBlock Text="Stored as plain text in the profile file. Do not put passwords here."
                               Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Margin="0,4,0,0" />
                    <CheckBox x:Name="EnabledBox" Content="Include this app in installs" Margin="0,16,0,0" />

                    <TextBlock Text="AFTER INSTALL" Style="{StaticResource Text.NavSection}" Margin="0,20,0,10" />
                    <StackPanel x:Name="CommandEditPanel">
                        <TextBlock Text="Program to run (blank = no command)" Style="{StaticResource Text.Label}" />
                        <TextBox x:Name="CommandExeBox" FontFamily="{StaticResource Font.Mono}" />
                        <TextBlock Text="Arguments, one per line (no shell is used)" Style="{StaticResource Text.Label}" Margin="0,12,0,6" />
                        <TextBox x:Name="CommandArgsBox" Height="64" AcceptsReturn="True" TextWrapping="NoWrap"
                                 FontFamily="{StaticResource Font.Mono}"
                                 VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto" />
                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="14" />
                                <ColumnDefinition Width="120" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Working directory (optional)" Style="{StaticResource Text.Label}" />
                                <TextBox x:Name="CommandDirBox" FontFamily="{StaticResource Font.Mono}" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Timeout (seconds)" Style="{StaticResource Text.Label}" />
                                <TextBox x:Name="CommandTimeoutBox" />
                            </StackPanel>
                        </Grid>
                        <CheckBox x:Name="CommandElevatedBox" Content="Run this command as administrator" Margin="0,12,0,0" />
                        <CheckBox x:Name="CommandEnabledBox" Content="Run this command after the app installs" Margin="0,8,0,0" />
                        <TextBlock Text="Commands run without a shell and are shown in full in the install preview."
                                   Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Margin="0,4,0,0" />
                    </StackPanel>
                    <StackPanel x:Name="CommandReadOnlyPanel" Visibility="Collapsed">
                        <TextBlock x:Name="CommandReadOnlyText" Style="{StaticResource Text.Caption}" TextWrapping="Wrap"
                                   FontFamily="{StaticResource Font.Mono}" Foreground="{DynamicResource Brush.TextPrimary}" />
                        <TextBlock Text="This profile did not originate on this PC, so its commands cannot be edited here. Review them from the review screen before they can run."
                                   Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Margin="0,4,0,0" />
                    </StackPanel>

                    <TextBlock x:Name="ErrorText" Foreground="{DynamicResource Brush.Danger}" FontSize="11.5"
                               TextWrapping="Wrap" Margin="0,12,0,0" Visibility="Collapsed" />
                </StackPanel>
            </ScrollViewer>

            <Border Grid.Row="2" Background="{DynamicResource Brush.SurfaceAlt}" BorderBrush="{DynamicResource Brush.Border}"
                    BorderThickness="0,1,0,0" Padding="24,14">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Cancel" Style="{StaticResource Button.Secondary}" MinWidth="84" Margin="0,0,8,0"
                            Click="Close_Click" />
                    <Button Content="Save changes" Style="{StaticResource Button.Primary}" MinWidth="110"
                            Click="Save_Click" IsDefault="True" />
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
