<UserControl x:Class="CtrlZ.App.Views.TweaksView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:CtrlZ.App.Localization"
             Focusable="False">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <Border Style="{StaticResource Border.Card}" Padding="18,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="{l:Tr Tweaks_SetWindowsUpTheWay}" FontSize="17" FontWeight="SemiBold"
                                   Foreground="{DynamicResource Brush.TextPrimary}" TextWrapping="Wrap" />
                        <TextBlock Style="{StaticResource Text.Secondary}" TextWrapping="Wrap" Margin="0,6,0,0"
                                   Text="{l:Tr Tweaks_EachTweakChangesAFew}" />
                        <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource Text.Caption}" Margin="0,8,0,0"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                    <Button Grid.Column="1" Content="{l:Tr Tweaks_RestartFileExplorer}" Style="{StaticResource Button.Secondary}"
                            VerticalAlignment="Top" Command="{Binding RestartExplorerCommand}"
                            Visibility="{Binding NeedsExplorerRestart, Converter={StaticResource BoolToVisibility}}"
                            ToolTip="{l:Tr Tweaks_SomeChangesShowUpOnly}" />
                </Grid>
            </Border>

            <Border Style="{StaticResource Border.Inset}" Padding="14,10" Margin="0,12,0,0"
                    Visibility="{Binding HasPendingFromProfile, Converter={StaticResource BoolToVisibility}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding PendingText}" Style="{StaticResource Text.Secondary}" VerticalAlignment="Center"
                               TextWrapping="Wrap" />
                    <Button Grid.Column="1" Content="{l:Tr Tweaks_ApplyThem}" Style="{StaticResource Button.Primary}" Margin="12,0,0,0"
                            Command="{Binding ApplyFromProfileCommand}" />
                </Grid>
            </Border>

            <ItemsControl ItemsSource="{Binding Rows}" Margin="0,12,0,0" Focusable="False">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource Border.Card}" Padding="16,12" Margin="0,0,0,8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="13.5"
                                               Foreground="{DynamicResource Brush.TextPrimary}" />
                                    <TextBlock Text="{Binding Description}" Style="{StaticResource Text.Secondary}"
                                               TextWrapping="Wrap" Margin="0,3,0,0" />
                                    <TextBlock Text="{Binding StateText}" Style="{StaticResource Text.Caption}" Margin="0,4,0,0" />
                                </StackPanel>
                                <Button Grid.Column="1" Content="{Binding ActionText}" Style="{StaticResource Button.Secondary}"
                                        MinWidth="84" VerticalAlignment="Center"
                                        AutomationProperties.Name="{Binding Title, StringFormat={l:Tr Tweaks_ApplyOrUndoName}}"
                                        Command="{Binding DataContext.ToggleCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>
