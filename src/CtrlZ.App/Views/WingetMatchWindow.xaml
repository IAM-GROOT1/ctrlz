<Window x:Class="CtrlZ.App.Views.WingetMatchWindow"
        FlowDirection="{x:Static l:AppLanguage.FlowDirection}"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:CtrlZ.App.Localization"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="{l:Tr WingetMatch_MatchToWinget}"
        Width="620" Height="590"
        WindowStyle="None"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{DynamicResource Brush.Surface}"
        Foreground="{DynamicResource Brush.TextPrimary}"
        FontFamily="{StaticResource Font.Text}">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="42" ResizeBorderThickness="0" GlassFrameThickness="0"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>
    <Border BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="42" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border Background="{DynamicResource Brush.SurfaceAlt}" BorderBrush="{DynamicResource Brush.Border}"
                    BorderThickness="0,0,0,1">
                <Grid>
                    <StackPanel Orientation="Horizontal" Margin="16,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="&#xE721;" FontFamily="{StaticResource Font.Icons}" FontSize="14"
                                   Foreground="{DynamicResource Brush.Accent}" Margin="0,0,9,0" />
                        <TextBlock Text="{l:Tr WingetMatch_MatchToWinget}" FontSize="13" FontWeight="SemiBold" />
                    </StackPanel>
                    <Button AutomationProperties.Name="{l:Tr WingetMatch_Close}" Style="{StaticResource Button.Window}" HorizontalAlignment="Right" Click="Close_Click">
                        <TextBlock Text="{StaticResource Icon.Close}" FontFamily="{StaticResource Font.Icons}" FontSize="10" />
                    </Button>
                </Grid>
            </Border>

            <StackPanel Grid.Row="1" Margin="22,20,22,12">
                <TextBlock Text="{l:Tr WingetMatch_FindTheWingetPackageFor}" Style="{StaticResource Text.BodyStrong}" />
                <TextBlock x:Name="AppNameText" Style="{StaticResource Text.Secondary}" Margin="0,3,0,12" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox AutomationProperties.Name="{l:Tr WingetMatch_SearchWinget}" x:Name="SearchBox" MinHeight="36" KeyDown="SearchBox_KeyDown" />
                    <Button Grid.Column="1" Content="{l:Tr WingetMatch_Search}" Style="{StaticResource Button.Secondary}"
                            Margin="8,0,0,0" Click="Search_Click" MinWidth="82" />
                </Grid>
                <TextBlock x:Name="SearchStatus" Style="{StaticResource Text.Caption}" Margin="0,8,0,0" />
            </StackPanel>

            <Border Grid.Row="2" Style="{StaticResource Border.Card}" Margin="22,0,22,12" Padding="4">
                <Grid>
                    <ListBox x:Name="ResultsList" SelectionChanged="ResultsList_SelectionChanged"
                             MouseDoubleClick="ResultsList_MouseDoubleClick">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="10,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Name, Converter={StaticResource UserText}}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding Id, Converter={StaticResource UserText}}" Style="{StaticResource Text.Caption}"
                                                   FontFamily="{StaticResource Font.Mono}" FlowDirection="LeftToRight" Margin="0,2,0,0" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" Text="{Binding Version}" Style="{StaticResource Text.Caption}"
                                               Margin="12,0,0,0" VerticalAlignment="Center" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <TextBlock x:Name="EmptyResults" Text="{l:Tr WingetMatch_SearchForTheAppName}"
                               Style="{StaticResource Text.Secondary}" HorizontalAlignment="Center"
                               VerticalAlignment="Center" TextAlignment="Center" Margin="24"
                               Visibility="Collapsed" />
                </Grid>
            </Border>

            <Border Grid.Row="3" Background="{DynamicResource Brush.SurfaceAlt}" BorderBrush="{DynamicResource Brush.Border}"
                    BorderThickness="0,1,0,0" Padding="22,14">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{l:Tr WingetMatch_PackageId}" Style="{StaticResource Text.Label}" Margin="0,0,12,0"
                                   VerticalAlignment="Center" />
                        <TextBox AutomationProperties.Name="{l:Tr WingetMatch_PackageId}" FlowDirection="LeftToRight" x:Name="PackageIdBox" Grid.Column="1" />
                    </Grid>
                    <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                        <Button Content="{l:Tr WingetMatch_Cancel}" Style="{StaticResource Button.Secondary}" MinWidth="84"
                                Margin="0,0,8,0" Click="Close_Click" />
                        <Button Content="{l:Tr WingetMatch_UseThisId}" Style="{StaticResource Button.Primary}" MinWidth="100"
                                Click="Use_Click" IsDefault="True" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
