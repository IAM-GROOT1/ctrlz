<UserControl x:Class="CtrlZ.App.Views.InstallView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:CtrlZ.App.Localization"
             xmlns:controls="clr-namespace:CtrlZ.App.Controls"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignHeight="620" d:DesignWidth="900">
    <UserControl.Resources>
        <DataTemplate x:Key="InstallRowTemplate">
            <Border BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,0,1" Padding="6,9">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="30" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="96" />
                        <ColumnDefinition Width="132" />
                        <ColumnDefinition Width="120" />
                    </Grid.ColumnDefinitions>
                    <controls:AppIcon IconPath="{Binding IconPath}" FallbackText="{Binding Name}" Size="28" VerticalAlignment="Top" />
                    <StackPanel Grid.Column="1" Margin="10,0,12,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="12.5" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding Detail}" Style="{StaticResource Text.Caption}" Margin="0,2,0,0"
                                   TextTrimming="CharacterEllipsis" MaxWidth="390" />
                        <TextBlock Text="{Binding NoteText}" Style="{StaticResource Text.Caption}" Margin="0,2,0,0"
                                   TextWrapping="Wrap" MaxWidth="390"
                                   Visibility="{Binding ShowsNote, Converter={StaticResource BoolToVisibility}}" />
                        <ProgressBar Value="{Binding Progress}" Maximum="1" Height="3" Margin="0,6,0,0"
                                     Visibility="{Binding ShowsProgress, Converter={StaticResource BoolToVisibility}}" />
                    </StackPanel>
                    <Border Grid.Column="2" Style="{StaticResource Border.Pill}" HorizontalAlignment="Left"
                            VerticalAlignment="Center">
                        <TextBlock Text="{Binding SourceLabel}" FontSize="10.5" Foreground="{DynamicResource Brush.TextSecondary}" />
                    </Border>
                    <Border Grid.Column="3" CornerRadius="10" Padding="8,2" BorderThickness="1" HorizontalAlignment="Left"
                            VerticalAlignment="Center">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="{DynamicResource Brush.SurfaceAlt}" />
                                <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Tone}" Value="success">
                                        <Setter Property="Background" Value="{DynamicResource Brush.SuccessSoft}" />
                                        <Setter Property="BorderBrush" Value="Transparent" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Tone}" Value="danger">
                                        <Setter Property="Background" Value="{DynamicResource Brush.DangerSoft}" />
                                        <Setter Property="BorderBrush" Value="Transparent" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Tone}" Value="warning">
                                        <Setter Property="Background" Value="{DynamicResource Brush.WarningSoft}" />
                                        <Setter Property="BorderBrush" Value="Transparent" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Tone}" Value="active">
                                        <Setter Property="Background" Value="{DynamicResource Brush.AccentSoft}" />
                                        <Setter Property="BorderBrush" Value="Transparent" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Text="{Binding StatusText}" FontSize="10.5" FontWeight="SemiBold">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Tone}" Value="success">
                                            <Setter Property="Foreground" Value="{DynamicResource Brush.Success}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Tone}" Value="danger">
                                            <Setter Property="Foreground" Value="{DynamicResource Brush.Danger}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Tone}" Value="warning">
                                            <Setter Property="Foreground" Value="{DynamicResource Brush.Warning}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Tone}" Value="active">
                                            <Setter Property="Foreground" Value="{DynamicResource Brush.Accent}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Border>
                    <TextBlock Grid.Column="4" Text="{Binding Attempts, StringFormat={l:Tr Install_AttemptNumber}}" Style="{StaticResource Text.Caption}"
                               HorizontalAlignment="Right" VerticalAlignment="Center" />
                </Grid>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- resume / reboot banner -->
        <Border Grid.Row="0" Style="{StaticResource Border.Inset}" Padding="12,9" Margin="0,0,0,10"
                Background="{DynamicResource Brush.AccentSoft}" BorderBrush="{DynamicResource Brush.Accent}"
                Visibility="{Binding HasResume, Converter={StaticResource BoolToVisibility}}">
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{StaticResource Icon.History}" FontFamily="{StaticResource Font.Icons}" FontSize="15"
                               Foreground="{DynamicResource Brush.Accent}" Margin="0,0,10,0" />
                    <StackPanel>
                        <TextBlock Text="{Binding ResumeTitle}" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Accent}" />
                        <TextBlock Text="{Binding ResumeMessage}" Style="{StaticResource Text.Caption}" />
                    </StackPanel>
                </StackPanel>
                <Button Content="{l:Tr Install_StartOver}" Style="{StaticResource Button.Ghost}" HorizontalAlignment="Right"
                        Command="{Binding StartOverCommand}" />
            </Grid>
        </Border>

        <Border Grid.Row="0" Style="{StaticResource Border.Inset}" Padding="12,9" Margin="0,0,0,10"
                Background="{DynamicResource Brush.WarningSoft}" BorderBrush="{DynamicResource Brush.Warning}"
                Visibility="{Binding HasReboot, Converter={StaticResource BoolToVisibility}}">
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{StaticResource Icon.Refresh}" FontFamily="{StaticResource Font.Icons}" FontSize="15"
                               Foreground="{DynamicResource Brush.Warning}" Margin="0,0,10,0" />
                    <StackPanel>
                        <TextBlock Text="{l:Tr Install_RestartRequired}" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Warning}" />
                        <TextBlock Text="{l:Tr Install_SomeInstallersFinishedButNeed}" Style="{StaticResource Text.Caption}" />
                    </StackPanel>
                </StackPanel>
                <Button Content="{l:Tr Install_RestartWindows}" Style="{StaticResource Button.Secondary}" HorizontalAlignment="Right"
                        Command="{Binding RestartWindowsCommand}" />
            </Grid>
        </Border>

        <!-- controls -->
        <Border Grid.Row="1" Style="{StaticResource Border.Card}" Padding="14,12" Margin="0,0,0,10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding ProfileName}" Style="{StaticResource Text.BodyStrong}" />
                            <Border Style="{StaticResource Border.Pill}" Margin="9,0,0,0">
                                <TextBlock Text="{Binding ElevationLabel}" FontSize="9.5"
                                           Foreground="{DynamicResource Brush.TextSecondary}" />
                            </Border>
                        </StackPanel>
                        <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource Text.Secondary}" Margin="0,3,0,0" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Content="{Binding StartLabel}" Style="{StaticResource Button.Primary}" MinWidth="132"
                                Command="{Binding StartCommand}" IsEnabled="{Binding CanStart}" />
                        <Button Content="{l:Tr Install_RetryFailed}" Style="{StaticResource Button.Secondary}" Margin="8,0,0,0"
                                Command="{Binding RetryFailedCommand}" IsEnabled="{Binding CanRetry}" />
                        <Button Content="{l:Tr Install_Pause}" Style="{StaticResource Button.Ghost}" Margin="4,0,0,0"
                                Command="{Binding CancelCommand}" Visibility="{Binding IsInstalling, Converter={StaticResource BoolToVisibility}}" />
                        <Button Content="{l:Tr Install_StartOver}" Style="{StaticResource Button.Ghost}" Margin="4,0,0,0"
                                Command="{Binding StartOverCommand}" Visibility="{Binding IsInstalling, Converter={StaticResource InverseBoolToVisibility}}" />
                    </StackPanel>
                </Grid>
                <Grid Grid.Row="1" Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ProgressBar Value="{Binding OverallProgress}" Maximum="100" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" Text="{Binding CountsText}" Style="{StaticResource Text.Caption}"
                               Margin="12,0,0,0" VerticalAlignment="Center" />
                </Grid>
            </Grid>
        </Border>

        <!-- queue -->
        <Border Grid.Row="2" Style="{StaticResource Border.Card}" Padding="0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Border Background="{DynamicResource Brush.SurfaceAlt}" Padding="10,7"
                        BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,0,1"
                        Visibility="{Binding HasItems, Converter={StaticResource BoolToVisibility}}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="30" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="96" />
                            <ColumnDefinition Width="132" />
                            <ColumnDefinition Width="120" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="1" Text="{l:Tr Install_APP}" Style="{StaticResource Text.NavSection}" Margin="16,0,0,0" />
                        <TextBlock Grid.Column="2" Text="{l:Tr Install_SOURCE}" Style="{StaticResource Text.NavSection}" Margin="0" />
                        <TextBlock Grid.Column="3" Text="{l:Tr Install_STATUS}" Style="{StaticResource Text.NavSection}" Margin="0" />
                    </Grid>
                </Border>
                <ListView x:Name="QueueList" Grid.Row="1" ItemsSource="{Binding Items}" ItemTemplate="{StaticResource InstallRowTemplate}"
                          ItemContainerStyle="{StaticResource {x:Type ListBoxItem}}"
                          BorderThickness="0" Background="Transparent"
                          ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                          VirtualizingPanel.IsVirtualizing="True"
                          VirtualizingPanel.VirtualizationMode="Recycling"
                          Visibility="{Binding HasItems, Converter={StaticResource BoolToVisibility}}" />

                <StackPanel Grid.RowSpan="2" VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="420"
                            Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}">
                    <Border Width="52" Height="52" CornerRadius="26" Background="{DynamicResource Brush.AccentSoft}"
                            HorizontalAlignment="Center">
                        <TextBlock Text="{StaticResource Icon.Install}" FontFamily="{StaticResource Font.Icons}" FontSize="22"
                                   Foreground="{DynamicResource Brush.Accent}" HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="{l:Tr Install_NothingQueuedYet}" Style="{StaticResource Text.SectionTitle}"
                               HorizontalAlignment="Center" Margin="0,16,0,4" />
                    <TextBlock Text="{l:Tr Install_AddAppsToAProfile}"
                               Style="{StaticResource Text.Secondary}" TextAlignment="Center" TextWrapping="Wrap" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,16,0,0">
                        <Button Content="{l:Tr Install_OpenMyApps}" Style="{StaticResource Button.Ghost}"
                                Click="OpenMyApps_Click" Margin="0,0,4,0" />
                        <Button Content="{l:Tr Install_ScanThisPC}" Style="{StaticResource Button.Primary}" Click="OpenScan_Click" />
                        <Button Content="{l:Tr Install_BrowseCatalog}" Style="{StaticResource Button.Secondary}" Margin="8,0,0,0"
                                Click="OpenCatalog_Click" />
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>

        <!-- live logs -->
        <Border Grid.Row="3" Style="{StaticResource Border.Card}" Margin="0,10,0,0" Padding="0"
                Visibility="{Binding ShowLogs, Converter={StaticResource BoolToVisibility}}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="150" />
                </Grid.RowDefinitions>
                <Border Background="{DynamicResource Brush.SurfaceAlt}" Padding="12,6"
                        BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,0,1">
                    <Grid>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{l:Tr Install_LIVELOG}" Style="{StaticResource Text.NavSection}" Margin="0" />
                            <TextBlock Text="{Binding LogPath}" Style="{StaticResource Text.Caption}"
                                       FontFamily="{StaticResource Font.Mono}" FlowDirection="LeftToRight" FontSize="9.5" Margin="10,0,0,0"
                                       TextTrimming="CharacterEllipsis" MaxWidth="470" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <CheckBox Content="{l:Tr Install_AutoScroll}" IsChecked="{Binding AutoScroll}" Margin="0,0,10,0"
                                      FontSize="10.5" />
                            <Button Content="{l:Tr Install_Clear}" Style="{StaticResource Button.Link}" Command="{Binding ClearLogCommand}" />
                            <Button Content="{l:Tr Install_OpenLog}" Style="{StaticResource Button.Link}" Margin="10,0,0,0"
                                    Command="{Binding OpenLogCommand}" />
                            <Button Content="{l:Tr Install_Hide}" Style="{StaticResource Button.Link}" Margin="10,0,0,0"
                                    Command="{Binding ToggleLogsCommand}" />
                        </StackPanel>
                    </Grid>
                </Border>
                <ListBox x:Name="LogList" Grid.Row="1" ItemsSource="{Binding Logs}" Background="{DynamicResource Brush.LogBackground}"
                         BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Auto"
                         ScrollViewer.VerticalScrollBarVisibility="Auto" VirtualizingPanel.IsVirtualizing="True">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <!-- Install messages are translated, so they follow the language direction. -->
                            <TextBlock Text="{Binding}" FontFamily="{StaticResource Font.Mono}" FlowDirection="{x:Static l:AppLanguage.FlowDirection}" FontSize="10.5"
                                       Foreground="{DynamicResource Brush.TextSecondary}" TextWrapping="NoWrap" />
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="12,1" />
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <ContentPresenter Margin="{TemplateBinding Padding}" />
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                </ListBox>
            </Grid>
        </Border>

        <Button Grid.Row="3" Content="{l:Tr Install_ShowLiveLog}" Style="{StaticResource Button.Ghost}" HorizontalAlignment="Left"
                Margin="0,8,0,0" Command="{Binding ToggleLogsCommand}"
                Visibility="{Binding ShowLogs, Converter={StaticResource InverseBoolToVisibility}}" />
    </Grid>
</UserControl>
