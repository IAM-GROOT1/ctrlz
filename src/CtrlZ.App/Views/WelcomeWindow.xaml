<Window x:Class="CtrlZ.App.Views.WelcomeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:CtrlZ.App.Localization"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="{l:Tr Welcome_WelcomeToCTRLZ}"
        Width="560"
        SizeToContent="Height"
        MaxHeight="760"
        WindowStyle="None"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{DynamicResource Brush.Surface}"
        Foreground="{DynamicResource Brush.TextPrimary}"
        FontFamily="{StaticResource Font.Text}">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="42" ResizeBorderThickness="0" GlassFrameThickness="0"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Border BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="42" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="{DynamicResource Brush.SurfaceAlt}"
                    BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,0,1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="46" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" Margin="16,0,0,0" VerticalAlignment="Center">
                        <Image Width="18" Height="18" Source="/Assets/ctrlz.png" Stretch="Uniform" Margin="0,0,9,0"
                               RenderOptions.BitmapScalingMode="HighQuality" />
                        <TextBlock Text="{l:Tr Welcome_WelcomeToCTRLZ}" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
                    </StackPanel>
                    <Button Grid.Column="1" Style="{StaticResource Button.Window}" IsCancel="True"
                            Click="Close_Click" AutomationProperties.Name="{l:Tr Welcome_Close}">
                        <TextBlock Text="&#xE711;" FontFamily="{StaticResource Font.Icons}" FontSize="10" />
                    </Button>
                </Grid>
            </Border>

            <StackPanel Grid.Row="1" Margin="24,20,24,8">
                <TextBlock Text="{l:Tr Welcome_ReinstallWindowsWithoutLosingYour}" Style="{StaticResource Text.SectionTitle}" />
                <TextBlock Style="{StaticResource Text.Secondary}" TextWrapping="Wrap" Margin="0,6,0,0"
                           Text="{l:Tr Welcome_CTRLZKeepsAList}" />

                <Border Style="{StaticResource Border.Card}" Padding="16,14" Margin="0,16,0,0">
                    <StackPanel>
                        <TextBlock Text="{l:Tr Welcome_BEFOREYOUREINSTALL}" Style="{StaticResource Text.NavSection}" Margin="0,0,0,8" />
                        <TextBlock Style="{StaticResource Text.Body}" TextWrapping="Wrap" Text="{l:Tr Welcome_1ScanThisPCTo}" />
                        <TextBlock Style="{StaticResource Text.Body}" TextWrapping="Wrap" Margin="0,4,0,0" Text="{l:Tr Welcome_2BackUpYourBrowsers}" />
                        <TextBlock Style="{StaticResource Text.Body}" TextWrapping="Wrap" Margin="0,4,0,0" Text="{l:Tr Welcome_3OpenReadyToWipe}" />
                        <TextBlock Style="{StaticResource Text.Body}" TextWrapping="Wrap" Margin="0,4,0,0" Text="{l:Tr Welcome_4CopyYourProfileAnd}" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Border.Card}" Padding="16,14" Margin="0,10,0,0">
                    <StackPanel>
                        <TextBlock Text="{l:Tr Welcome_ONAFRESHINSTALL}" Style="{StaticResource Text.NavSection}" Margin="0,0,0,8" />
                        <TextBlock Style="{StaticResource Text.Body}" TextWrapping="Wrap" Text="{l:Tr Welcome_1ImportYourProfileIn}" />
                        <TextBlock Style="{StaticResource Text.Body}" TextWrapping="Wrap" Margin="0,4,0,0" Text="{l:Tr Welcome_2CheckTheInstallPreview}" />
                        <TextBlock Style="{StaticResource Text.Body}" TextWrapping="Wrap" Margin="0,4,0,0" Text="{l:Tr Welcome_3RestoreYourBrowserBackups}" />
                    </StackPanel>
                </Border>

                <TextBlock Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Margin="0,12,0,0"
                           Text="{l:Tr Welcome_YouCanOpenThisGuide}" />
            </StackPanel>

            <Border Grid.Row="2" Padding="24,12,24,18">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="{l:Tr Welcome_IMOnAFresh}" Style="{StaticResource Button.Secondary}" Margin="0,0,8,0"
                            Click="FreshInstall_Click" />
                    <Button x:Name="StartButton" Content="{l:Tr Welcome_StartWithAScan}" Style="{StaticResource Button.Primary}"
                            Click="Scan_Click" MinWidth="120" IsDefault="True" />
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
