<Window x:Class="CtrlZ.App.Views.WelcomeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Welcome to CTRL+Z"
        Width="560"
        SizeToContent="Height"
        MaxHeight="760"
        WindowStyle="None"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{DynamicResource Brush.Surface}"
        Foreground="{DynamicResource Brush.TextPrimary}"
        FontFamily="{StaticResource Font.Text}">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="42" ResizeBorderThickness="0" GlassFrameThickness="0"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Border BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="42" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="{DynamicResource Brush.SurfaceAlt}"
                    BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,0,1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="46" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" Margin="16,0,0,0" VerticalAlignment="Center">
                        <Image Width="18" Height="18" Source="/Assets/ctrlz.png" Stretch="Uniform" Margin="0,0,9,0"
                               RenderOptions.BitmapScalingMode="HighQuality" />
                        <TextBlock Text="Welcome to CTRL+Z" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
                    </StackPanel>
                    <Button Grid.Column="1" Style="{StaticResource Button.Window}" IsCancel="True"
                            Click="Close_Click" AutomationProperties.Name="Close">
                        <TextBlock Text="&#xE711;" FontFamily="{StaticResource Font.Icons}" FontSize="10" />
                    </Button>
                </Grid>
            </Border>

            <StackPanel Grid.Row="1" Margin="24,20,24,8">
                <TextBlock Text="Reinstall Windows without losing your setup." Style="{StaticResource Text.SectionTitle}" />
                <TextBlock Style="{StaticResource Text.Secondary}" TextWrapping="Wrap" Margin="0,6,0,0"
                           Text="CTRL+Z keeps a list of your apps and backs up your browsers, then puts them back on a fresh install. Everything stays on this PC unless you copy it somewhere." />

                <Border Style="{StaticResource Border.Card}" Padding="16,14" Margin="0,16,0,0">
                    <StackPanel>
                        <TextBlock Text="BEFORE YOU REINSTALL" Style="{StaticResource Text.NavSection}" Margin="0,0,0,8" />
                        <TextBlock Style="{StaticResource Text.Body}" TextWrapping="Wrap" Text="1.  Scan this PC to build your app list, then tidy it in My Apps." />
                        <TextBlock Style="{StaticResource Text.Body}" TextWrapping="Wrap" Margin="0,4,0,0" Text="2.  Back up your browsers (bookmarks, history, extensions; never passwords or cookies)." />
                        <TextBlock Style="{StaticResource Text.Body}" TextWrapping="Wrap" Margin="0,4,0,0" Text="3.  Open Ready to wipe and work through the checklist." />
                        <TextBlock Style="{StaticResource Text.Body}" TextWrapping="Wrap" Margin="0,4,0,0" Text="4.  Copy your profile and browser backups to a USB drive or another PC." />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Border.Card}" Padding="16,14" Margin="0,10,0,0">
                    <StackPanel>
                        <TextBlock Text="ON A FRESH INSTALL" Style="{StaticResource Text.NavSection}" Margin="0,0,0,8" />
                        <TextBlock Style="{StaticResource Text.Body}" TextWrapping="Wrap" Text="1.  Import your profile in My Apps." />
                        <TextBlock Style="{StaticResource Text.Body}" TextWrapping="Wrap" Margin="0,4,0,0" Text="2.  Check the install preview, then install everything in one go." />
                        <TextBlock Style="{StaticResource Text.Body}" TextWrapping="Wrap" Margin="0,4,0,0" Text="3.  Restore your browser backups on the Browsers page." />
                    </StackPanel>
                </Border>

                <TextBlock Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Margin="0,12,0,0"
                           Text="You can open this guide again from Settings. Ctrl+1 to Ctrl+8 jump between pages." />
            </StackPanel>

            <Border Grid.Row="2" Padding="24,12,24,18">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="I'm on a fresh install" Style="{StaticResource Button.Secondary}" Margin="0,0,8,0"
                            Click="FreshInstall_Click" />
                    <Button x:Name="StartButton" Content="Start with a scan" Style="{StaticResource Button.Primary}"
                            Click="Scan_Click" MinWidth="120" IsDefault="True" />
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
