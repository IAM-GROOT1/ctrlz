<UserControl x:Class="CtrlZ.App.Views.AddAppView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignHeight="620" d:DesignWidth="900">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- source selector -->
        <Grid Grid.Row="0" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Style="{StaticResource Border.Inset}" Padding="2">
                <StackPanel Orientation="Horizontal">
                    <ToggleButton Content="Direct link" Style="{StaticResource Toggle.Pill}"
                                  IsChecked="{Binding IsDirectTab, Mode=TwoWay}" />
                    <ToggleButton Content="GitHub release" Style="{StaticResource Toggle.Pill}"
                                  IsChecked="{Binding IsGitHubTab, Mode=TwoWay}" />
                    <ToggleButton Content="Local file" Style="{StaticResource Toggle.Pill}"
                                  IsChecked="{Binding IsLocalTab, Mode=TwoWay}" />
                </StackPanel>
            </Border>
            <TextBlock Grid.Column="1" Text="{Binding StatusMessage}" Style="{StaticResource Text.Secondary}"
                       Margin="14,0,0,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.08*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="0.92*" />
            </Grid.ColumnDefinitions>

            <!-- form -->
            <Border Grid.Column="0" Style="{StaticResource Border.Card}" Padding="0">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="18,16,18,14">
                    <StackPanel>
                        <TextBlock Text="APP DETAILS" Style="{StaticResource Text.NavSection}" Margin="0,0,0,10" />
                        <TextBlock Text="Name" Style="{StaticResource Text.Label}" />
                        <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />

                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="180" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Publisher (optional)" Style="{StaticResource Text.Label}" />
                                <TextBox Text="{Binding Publisher, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Category" Style="{StaticResource Text.Label}" />
                                <ComboBox ItemsSource="{Binding Categories}" SelectedItem="{Binding SelectedCategory}"
                                          DisplayMemberPath="Label" />
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="INSTALLER SOURCE" Style="{StaticResource Text.NavSection}" Margin="0,20,0,10" />

                        <StackPanel Visibility="{Binding IsDirect, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="Download URL" Style="{StaticResource Text.Label}" />
                            <TextBox Text="{Binding Url, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Text="Save as file name (optional)" Style="{StaticResource Text.Label}" Margin="0,12,0,6" />
                            <TextBox Text="{Binding FileName, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Text="The app downloads at install time. Add switches on the right so it installs silently."
                                       Style="{StaticResource Text.Caption}" Margin="0,6,0,0" TextWrapping="Wrap" />
                        </StackPanel>

                        <StackPanel Visibility="{Binding IsGitHub, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="Repository" Style="{StaticResource Text.Label}" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox Text="{Binding Repo, UpdateSourceTrigger=PropertyChanged}" />
                                <Button Grid.Column="1" Content="Find latest" Style="{StaticResource Button.Secondary}"
                                        Margin="8,0,0,0" Command="{Binding FindReleaseCommand}"
                                        IsEnabled="{Binding IsLoadingRelease, Converter={StaticResource BoolNegation}}" />
                            </Grid>
                            <TextBlock Text="{Binding ReleaseInfo}" Style="{StaticResource Text.Caption}" Margin="0,7,0,0"
                                       TextWrapping="Wrap" />
                            <TextBlock Text="Release assets" Style="{StaticResource Text.Label}" Margin="0,12,0,6" />
                            <Border Style="{StaticResource Border.Inset}" Height="142" Padding="3">
                                <Grid>
                                    <ListBox ItemsSource="{Binding Assets}" SelectedItem="{Binding SelectedAsset}"
                                             Visibility="{Binding HasAssets, Converter={StaticResource BoolToVisibility}}">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="8,5">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="11.5"
                                                                   TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Text="{Binding Detail}" Style="{StaticResource Text.Caption}" />
                                                    </StackPanel>
                                                    <TextBlock Grid.Column="1" Text="{Binding SuggestedKind}"
                                                               Style="{StaticResource Text.Caption}" VerticalAlignment="Center"
                                                               Margin="8,0,0,0" />
                                                </Grid>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                    <TextBlock Text="Find the latest release to choose a Windows asset."
                                               Style="{StaticResource Text.Secondary}" HorizontalAlignment="Center"
                                               VerticalAlignment="Center" TextAlignment="Center" Margin="20"
                                               Visibility="{Binding HasAssets, Converter={StaticResource InverseBoolToVisibility}}" />
                                </Grid>
                            </Border>
                            <TextBlock Text="Asset handling" Style="{StaticResource Text.Label}" Margin="0,12,0,6" />
                            <ComboBox ItemsSource="{Binding AssetKinds}" SelectedItem="{Binding SelectedAssetKind}"
                                      DisplayMemberPath="Label" />
                            <TextBlock Text="The latest release is checked again at install time; the chosen asset type is reused, not the stale version."
                                       Style="{StaticResource Text.Caption}" Margin="0,6,0,0" TextWrapping="Wrap" />
                        </StackPanel>

                        <StackPanel Visibility="{Binding IsLocal, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="Installer file" Style="{StaticResource Text.Label}" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox Text="{Binding LocalPath, UpdateSourceTrigger=PropertyChanged}" />
                                <Button Grid.Column="1" Content="File…" Style="{StaticResource Button.Secondary}"
                                        Margin="8,0,0,0" Command="{Binding BrowseLocalCommand}" />
                                <Button Grid.Column="2" Content="Folder…" Style="{StaticResource Button.Ghost}"
                                        Margin="4,0,0,0" Command="{Binding BrowseFolderCommand}" />
                            </Grid>
                            <TextBlock Text="Keep the USB drive or folder available when you run the install."
                                       Style="{StaticResource Text.Caption}" Margin="0,6,0,0" TextWrapping="Wrap" />
                        </StackPanel>

                        <TextBlock Text="NOTES" Style="{StaticResource Text.NavSection}" Margin="0,20,0,10" />
                        <TextBox Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}" Height="64" AcceptsReturn="True"
                                 TextWrapping="Wrap" VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto" />
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- silent install -->
            <Border Grid.Column="2" Style="{StaticResource Border.Card}" Padding="0">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="18,16,18,14">
                    <StackPanel>
                        <TextBlock Text="SILENT INSTALL" Style="{StaticResource Text.NavSection}" Margin="0,0,0,10" />
                        <TextBlock Text="CTRL+Z detects the installer type and picks a known switch set. Custom switches always win."
                                   Style="{StaticResource Text.Secondary}" TextWrapping="Wrap" />

                        <Border Style="{StaticResource Border.Inset}" Padding="11,9" Margin="0,14,0,0">
                            <Grid>
                                <TextBlock Text="Detected" Style="{StaticResource Text.Label}" Margin="0,0,0,3" />
                                <TextBlock Text="{Binding DetectedInstaller}" FontWeight="SemiBold" FontSize="12.5"
                                           Margin="0,15,0,0" TextWrapping="Wrap" />
                            </Grid>
                        </Border>

                        <TextBlock Text="Silent switches" Style="{StaticResource Text.Label}" Margin="0,14,0,6" />
                        <TextBox Text="{Binding SilentArgs, UpdateSourceTrigger=PropertyChanged}" FontFamily="{StaticResource Font.Mono}" />
                        <WrapPanel Margin="0,8,0,0">
                            <Button Content="Inspect installer" Style="{StaticResource Button.Secondary}"
                                    Command="{Binding DetectInstallerCommand}" Margin="0,0,6,6" />
                            <Button Content="Use recommended" Style="{StaticResource Button.Ghost}"
                                    Command="{Binding UseRecommendedCommand}" IsEnabled="{Binding HasRecommended}"
                                    Margin="0,0,2,6" />
                            <Button Content="Test…" Style="{StaticResource Button.Ghost}"
                                    Command="{Binding TestInstallerCommand}" IsEnabled="{Binding CanTest}"
                                    Margin="0,0,0,6" />
                        </WrapPanel>
                        <TextBlock Text="{Binding RecommendedArgs}" Style="{StaticResource Text.Caption}"
                                   FontFamily="{StaticResource Font.Mono}" TextWrapping="Wrap" Margin="0,8,0,0" />

                        <TextBlock Text="Command preview" Style="{StaticResource Text.Label}" Margin="0,16,0,6" />
                        <Border Style="{StaticResource Border.Inset}" Background="{DynamicResource Brush.LogBackground}" Padding="10,8">
                            <TextBlock Text="{Binding PreviewCommand, TargetNullValue='Inspect an installer to preview the command.'}"
                                       FontFamily="{StaticResource Font.Mono}" FontSize="10.5" TextWrapping="Wrap"
                                       Foreground="{DynamicResource Brush.TextSecondary}" />
                        </Border>

                        <TextBlock Text="SHA-256 (optional)" Style="{StaticResource Text.Label}" Margin="0,14,0,6" />
                        <TextBox Text="{Binding Hash, UpdateSourceTrigger=PropertyChanged}" FontFamily="{StaticResource Font.Mono}" />
                        <TextBlock Text="GitHub release digests are filled automatically when available. winget verifies its own manifests."
                                   Style="{StaticResource Text.Caption}" Margin="0,6,0,0" TextWrapping="Wrap" />

                        <StackPanel Margin="0,16,0,0" Visibility="{Binding HasTestLog, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="Test output" Style="{StaticResource Text.Label}" />
                            <TextBox Text="{Binding TestLog}" Style="{StaticResource Text.LogBox}" IsReadOnly="True"
                                     Height="150" VerticalScrollBarVisibility="Auto" />
                        </StackPanel>

                        <Border Style="{StaticResource Border.Inset}" Padding="11,9" Margin="0,16,0,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{StaticResource Icon.Shield}" FontFamily="{StaticResource Font.Icons}" FontSize="14"
                                           Foreground="{DynamicResource Brush.TextTertiary}" Margin="0,0,9,0"
                                           VerticalAlignment="Top" />
                                <TextBlock Grid.Column="1" Text="Passwords and cookies are excluded from browser backups. Installer downloads are verified when a hash is available."
                                           Style="{StaticResource Text.Caption}" TextWrapping="Wrap" />
                            </Grid>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- footer -->
        <Grid Grid.Row="2" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="{Binding ErrorMessage}" Foreground="{DynamicResource Brush.Danger}" FontSize="11.5"
                           TextWrapping="Wrap" Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}" />
                <TextBlock Text="The app is saved in the profile only. Installers are not downloaded until install time."
                           Style="{StaticResource Text.Caption}" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Content="Clear" Style="{StaticResource Button.Ghost}" Margin="0,0,8,0" Command="{Binding ClearFormCommand}" />
                <Button Content="{Binding AddButtonText}" Style="{StaticResource Button.Primary}" MinWidth="150"
                        Command="{Binding AddCommand}" />
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
